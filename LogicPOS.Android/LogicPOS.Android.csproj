<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Retail entry: DevEditionBanner hides when name contains Host or +retail. -->
    <RootNamespace>LogicPOS.Host.Android</RootNamespace>
    <AssemblyName>LogicPOS.Host.Android</AssemblyName>
    <ApplicationId>com.logicpulse.logicpos</ApplicationId>
    <ApplicationVersion>5</ApplicationVersion>
    <ApplicationDisplayVersion>1.6.7</ApplicationDisplayVersion>
    <Version>1.6.7</Version>
    <InformationalVersion>1.6.7+retail</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- AOT Release falha em System.Private.Windows.Core (Nrbf); JIT basta no tablet. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- APK autónomo para adb install (sem Fast Deployment / .__override__). -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RuntimeIdentifiers>android-x64;android-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <!-- Retail local SQLite (not public Desktop opensource defaults). -->
  <ItemGroup>
    <AndroidAsset Include="appsettings.json" Link="assets\appsettings.json" />
    <AndroidAsset Include="..\db_seeds\**\*" Link="assets\db_seeds\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogicPOS.App\logicpos.csproj" />
    <ProjectReference Include="..\LogicPOS.Core\LogicPOS.Core.csproj" />
    <ProjectReference Include="..\..\logicPOS-internal\client\src\LogicPOS.Cloud\LogicPOS.Cloud.csproj" />
    <ProjectReference Include="..\..\logicPOS-internal\api\src\LogicPOS.Licence\LogicPOS.Licence.csproj" />
  </ItemGroup>

  <!-- LogicPulse Host composition (retail) without Avalonia.Desktop. -->
  <ItemGroup>
    <Compile Include="..\..\logicPOS-internal\host\LogicPOS.Host\LogicPulseComposition.cs" Link="Host\LogicPulseComposition.cs" />
    <Compile Include="..\..\logicPOS-internal\host\LogicPOS.Host\LogicPulseCompositionOptions.cs" Link="Host\LogicPulseCompositionOptions.cs" />
    <Compile Include="..\..\logicPOS-internal\host\LogicPOS.Host\Licensing\*.cs" Link="Host\Licensing\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
