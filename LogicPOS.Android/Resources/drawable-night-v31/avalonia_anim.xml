<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="vector"
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <!-- Fundo verde arredondado -->
            <path
                android:name="bg"
                android:pathData="M14,14h80c4.4,0 8,3.6 8,8v64c0,4.4 -3.6,8 -8,8H14c-4.4,0 -8,-3.6 -8,-8V22c0,-4.4 3.6,-8 8,-8z"
                android:fillColor="#8EC641" />
            <!-- Quadrado superior esquerdo -->
            <path
                android:name="sq_tl"
                android:pathData="M20,24h26c3.3,0 6,2.7 6,6v22c0,3.3 -2.7,6 -6,6H20c-3.3,0 -6,-2.7 -6,-6V30c0,-3.3 2.7,-6 6,-6z"
                android:fillColor="#00FFFFFF" />
            <!-- Quadrado superior direito -->
            <path
                android:name="sq_tr"
                android:pathData="M62,24h26c3.3,0 6,2.7 6,6v22c0,3.3 -2.7,6 -6,6H62c-3.3,0 -6,-2.7 -6,-6V30c0,-3.3 2.7,-6 6,-6z"
                android:fillColor="#00FFFFFF" />
            <!-- Quadrado inferior esquerdo -->
            <path
                android:name="sq_bl"
                android:pathData="M20,58h26c3.3,0 6,2.7 6,6v22c0,3.3 -2.7,6 -6,6H20c-3.3,0 -6,-2.7 -6,-6V64c0,-3.3 2.7,-6 6,-6z"
                android:fillColor="#00FFFFFF" />
            <!-- Quadrado inferior direito -->
            <path
                android:name="sq_br"
                android:pathData="M62,58h26c3.3,0 6,2.7 6,6v22c0,3.3 -2.7,6 -6,6H62c-3.3,0 -6,-2.7 -6,-6V64c0,-3.3 2.7,-6 6,-6z"
                android:fillColor="#00FFFFFF" />
        </vector>
    </aapt:attr>
    <!-- Animação: quadrados aparecem branco (fade-in) -->
    <target android:name="sq_tl">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillColor"
                android:duration="500"
                android:valueFrom="#00FFFFFF"
                android:valueTo="#FFFFFFFF"
                android:valueType="colorType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="sq_tr">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillColor"
                android:startOffset="150"
                android:duration="500"
                android:valueFrom="#00FFFFFF"
                android:valueTo="#FFFFFFFF"
                android:valueType="colorType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="sq_bl">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillColor"
                android:startOffset="300"
                android:duration="500"
                android:valueFrom="#00FFFFFF"
                android:valueTo="#FFFFFFFF"
                android:valueType="colorType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="sq_br">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillColor"
                android:startOffset="450"
                android:duration="500"
                android:valueFrom="#00FFFFFF"
                android:valueTo="#FFFFFFFF"
                android:valueType="colorType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
