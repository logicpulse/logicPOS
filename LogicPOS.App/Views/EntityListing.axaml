<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:views="using:LogicPOS.App.Views"
             x:Class="LogicPOS.App.Views.EntityListing"
             Classes="bo_listing">
    <Panel>
        <Border x:Name="ListingSurface" Classes="bo_doc_page">
            <DockPanel>
                <StackPanel Classes="bo_doc_header" DockPanel.Dock="Top">
                    <Border Classes="bo_page_header">
                        <DockPanel>
                            <StackPanel Classes="bo_page_actions" DockPanel.Dock="Right">
                                <StackPanel x:Name="ActionBar" Classes="bo_page_actions" />
                                <StackPanel x:Name="CreateBar" Classes="bo_page_actions" />
                            </StackPanel>
                            <StackPanel x:Name="PageTitleRow" Classes="bo_page_title_row">
                                <svg:Svg x:Name="TitleIcon" Classes="bo_page_title_icon" IsVisible="False" />
                                <TextBlock x:Name="TitleText" Classes="bo_page_title" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DockPanel x:Name="MobileBar" Classes="bo_mobile_bar" IsVisible="False">
                        <Button Classes="bo_mobile_bar_button" DockPanel.Dock="Right" Content="Mais" Click="OnMobileMoreClick" />
                        <Button Classes="bo_mobile_bar_button" DockPanel.Dock="Right" Content="Filtros" Click="OnMobileFilterClick" />
                        <Border Classes="bo_listing_search">
                            <DockPanel>
                                <Button Classes="bo_listing_icon_button" DockPanel.Dock="Right" Click="OnSearchClick" ToolTip.Tip="Procurar">
                                    <svg:Svg Classes="bo_listing_icon" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_pesquisar_b.svg" />
                                </Button>
                                <TextBox x:Name="MobileSearchBox"
                                         Classes="bo_listing_search_box"
                                         PlaceholderText="Procurar"
                                         TextChanged="OnMobileSearchChanged"
                                         KeyUp="OnSearchKeyUp" />
                            </DockPanel>
                        </Border>
                    </DockPanel>
                    <DockPanel x:Name="DesktopTools" Classes="bo_doc_tools">
                        <StackPanel x:Name="DateFilters" Classes="bo_doc_filters" DockPanel.Dock="Left">
                            <views:PeriodRangeField x:Name="Period" />
                            <StackPanel x:Name="CustomerFilterField" Classes="bo_doc_date_field" IsVisible="False">
                                <TextBlock Classes="bo_doc_label" Text="Cliente" />
                                <AutoCompleteBox x:Name="CustomerBox" Classes="bo_doc_filter_search" SelectionChanged="OnCustomerFilterChanged" />
                            </StackPanel>
                            <Button Classes="bo_listing_icon_button" Click="OnFilterClick" ToolTip.Tip="Filtrar">
                                <svg:Svg Classes="bo_listing_icon" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_filtro_b.svg" />
                            </Button>
                        </StackPanel>
                        <ListBox x:Name="ModeBox" Classes="bo_entity_mode" DockPanel.Dock="Left" IsVisible="False" SelectionMode="Single,AlwaysSelected" SelectionChanged="OnModeChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <TextBlock x:Name="Notice" Classes="bo_doc_count_inline" DockPanel.Dock="Left" />
                        <DockPanel Classes="bo_listing_tools">
                            <Button Classes="bo_listing_icon_button" DockPanel.Dock="Right" Click="OnExportPdfClick" ToolTip.Tip="Exportar para PDF">
                                <svg:Svg Classes="bo_listing_icon" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_pdf.svg" />
                            </Button>
                            <Button Classes="bo_listing_icon_button" DockPanel.Dock="Right" Click="OnExportExcelClick" ToolTip.Tip="Exportar para Excel">
                                <svg:Svg Classes="bo_listing_icon" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_xlsx.svg" />
                            </Button>
                            <Button x:Name="CatalogImportButton"
                                    Classes="bo_listing_icon_button"
                                    DockPanel.Dock="Right"
                                    IsVisible="False"
                                    Click="OnCatalogImportClick"
                                    ToolTip.Tip="Importar">
                                <svg:Svg Classes="bo_listing_icon" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_importar_b.svg" />
                            </Button>
                            <!-- Right-packed group; search is fill so it can shrink under FO width. -->
                            <DockPanel HorizontalAlignment="Right">
                                <Button Classes="bo_listing_icon_button" DockPanel.Dock="Left" Click="OnClearFilterClick" ToolTip.Tip="Limpar filtro">
                                    <svg:Svg Classes="bo_listing_icon" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_filtro_b.svg" />
                                </Button>
                                <Button Classes="bo_listing_icon_button" DockPanel.Dock="Left" Click="OnResetClick" ToolTip.Tip="Repor">
                                    <svg:Svg Classes="bo_listing_icon" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_repor_b.svg" />
                                </Button>
                                <Button Classes="bo_listing_columns" DockPanel.Dock="Left" Content="Colunas ▾" Click="OnChooseColumnsClick" ToolTip.Tip="Colunas" />
                                <Border Classes="bo_listing_search">
                                    <DockPanel>
                                        <Button Classes="bo_listing_icon_button" DockPanel.Dock="Right" Click="OnSearchClick" ToolTip.Tip="Procurar">
                                            <svg:Svg Classes="bo_listing_icon" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_pesquisar_b.svg" />
                                        </Button>
                                        <TextBox x:Name="SearchBox"
                                                 Classes="bo_listing_search_box"
                                                 PlaceholderText="Procurar"
                                                 TextChanged="OnSearchChanged" />
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                        </DockPanel>
                    </DockPanel>
                </StackPanel>
                <Panel>
                    <ListBox x:Name="CardList"
                             Classes="bo_listing_cards"
                             IsVisible="False"
                             SelectionMode="Single"
                             Tapped="OnCardTapped" />
                    <ScrollViewer x:Name="DeviceCardScroll" IsVisible="False">
                        <ItemsControl x:Name="DeviceCardGrid" Classes="bo_device_card_grid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Classes="bo_device_card_wrap" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <DataGrid x:Name="Grid"
                              Classes="bo_doc_grid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              DoubleTapped="OnGridDoubleTapped" />
                    <views:ListingBusy x:Name="Busy" ZIndex="100" />
                    <Border x:Name="ColumnChooser" Classes="login_alert_frame bo_doc_chooser" IsVisible="False">
                        <DockPanel Classes="bo_doc_chooser_body">
                            <TextBlock Classes="bo_doc_title" DockPanel.Dock="Top" Text="Escolher coluna" />
                            <TextBox x:Name="ColumnSearch"
                                     Classes="bo_doc_search"
                                     DockPanel.Dock="Top"
                                     PlaceholderText="Procurar"
                                     TextChanged="OnColumnSearchChanged" />
                            <StackPanel Classes="bo_doc_chooser_actions" DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8">
                                <Button Classes="bo_doc_filter" Content="OK" Click="OnColumnsOkClick" />
                                <Button Classes="bo_doc_page_button" Content="Cancelar" Click="OnColumnsCancelClick" />
                            </StackPanel>
                            <ScrollViewer>
                                <StackPanel x:Name="ColumnChecks" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Panel>
            </DockPanel>
        </Border>

        <Panel x:Name="FilterSheet" Classes="login_alert_overlay" IsVisible="False">
            <Border Classes="login_alert_frame bo_mobile_sheet">
                <DockPanel Classes="login_alert_inner">
                    <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                        <StackPanel Classes="login_alert_title_row">
                            <TextBlock Classes="login_alert_title" Text="Filtros" />
                        </StackPanel>
                    </Border>
                    <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                        <StackPanel Classes="login_alert_action_buttons">
                            <Button Classes="login_alert_action" Click="OnMobileFilterApplyClick">
                                <TextBlock Classes="login_alert_action_text" Text="Filtrar" />
                            </Button>
                            <Button Classes="login_alert_action action_secondary" Click="OnMobileFilterCloseClick">
                                <TextBlock Classes="login_alert_action_text" Text="Fechar" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel x:Name="FilterSheetHost" Classes="bo_entity_form" Spacing="12" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <Panel x:Name="MoreSheet" Classes="login_alert_overlay" IsVisible="False">
            <Border Classes="login_alert_frame bo_mobile_sheet">
                <DockPanel Classes="login_alert_inner">
                    <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                        <StackPanel Classes="login_alert_title_row">
                            <TextBlock Classes="login_alert_title" Text="Mais" />
                        </StackPanel>
                    </Border>
                    <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                        <StackPanel Classes="login_alert_action_buttons">
                            <Button Classes="login_alert_action action_secondary" Click="OnMobileMoreCloseClick">
                                <TextBlock Classes="login_alert_action_text" Text="Fechar" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel x:Name="MoreSheetHost" Classes="bo_entity_form" Spacing="8" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <Panel x:Name="EditorOverlay" Classes="login_alert_overlay" IsVisible="False">
            <Border x:Name="EditorFrame" Classes="login_alert_frame bo_entity_editor bo_entity_editor_article">
                <DockPanel Classes="login_alert_inner">
                    <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                        <DockPanel>
                            <Button Classes="bo_window_button" DockPanel.Dock="Right" Click="OnEditorCancelClick"
                                    ToolTip.Tip="Fechar">
                                <svg:Svg Classes="bo_window_icon"
                                         Path="avares://LogicPOS.App/Assets/Images/BackOffice/botao_fechar_w.svg" />
                            </Button>
                            <StackPanel Classes="login_alert_title_row">
                                <Image x:Name="EditorTitleIcon" Classes="login_alert_title_icon"
                                       Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_info_window.png" />
                                <TextBlock x:Name="EditorTitle" Classes="login_alert_title" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                        <StackPanel Classes="login_alert_action_buttons">
                            <Button Classes="login_alert_action" Click="OnSaveClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Guardar" />
                                </StackPanel>
                            </Button>
                            <Button Classes="login_alert_action action_secondary" Click="OnEditorCancelClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Cancelar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="EditorNotice" Classes="bo_entity_error" DockPanel.Dock="Bottom" />
                    <ScrollViewer x:Name="EditorBody">
                        <StackPanel x:Name="EditorFields" Classes="bo_entity_form" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <Panel x:Name="BulkOverlay" Classes="login_alert_overlay" IsVisible="False">
            <Border Classes="login_alert_frame bo_entity_editor bo_entity_editor_narrow bo_entity_editor_fit" MaxHeight="680">
                <DockPanel Classes="login_alert_inner">
                    <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                        <DockPanel>
                            <Button Classes="bo_window_button" DockPanel.Dock="Right" Click="OnBulkCancelClick"
                                    ToolTip.Tip="Fechar">
                                <svg:Svg Classes="bo_window_icon"
                                         Path="avares://LogicPOS.App/Assets/Images/BackOffice/botao_fechar_w.svg" />
                            </Button>
                            <StackPanel Classes="login_alert_title_row">
                                <Image Classes="login_alert_title_icon"
                                       Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_info_window.png" />
                                <TextBlock x:Name="BulkTitle" Classes="login_alert_title" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                        <StackPanel Classes="login_alert_action_buttons">
                            <Button x:Name="BulkSaveButton" Classes="login_alert_action" Click="OnBulkSaveClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Guardar" />
                                </StackPanel>
                            </Button>
                            <Button Classes="login_alert_action action_secondary" Click="OnBulkCancelClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Cancelar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="BulkNotice" Classes="bo_entity_error" DockPanel.Dock="Bottom" />
                    <ScrollViewer>
                        <StackPanel x:Name="BulkFields" Classes="bo_entity_form bo_article_sections" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <Panel x:Name="FiscalYearOverlay" Classes="login_alert_overlay" IsVisible="False">
            <views:FiscalYearWizard x:Name="FiscalYearHost" />
        </Panel>

        <Panel x:Name="ArticleSetupOverlay" Classes="login_alert_overlay" IsVisible="False">
            <views:ArticleSetupWizard x:Name="ArticleSetupHost" />
        </Panel>

        <Panel x:Name="FinalConsumerSetupOverlay" Classes="login_alert_overlay" IsVisible="False">
            <views:FinalConsumerSetupWizard x:Name="FinalConsumerSetupHost" />
        </Panel>

        <Panel x:Name="TableSetupOverlay" Classes="login_alert_overlay" IsVisible="False">
            <views:TableSetupWizard x:Name="TableSetupHost" />
        </Panel>

        <Panel x:Name="PrinterSetupOverlay" Classes="login_alert_overlay" IsVisible="False">
            <views:PrinterSetupWizard x:Name="PrinterSetupHost" />
        </Panel>

        <Panel x:Name="ImportOverlay" Classes="login_alert_overlay" IsVisible="False">
            <Border Classes="login_alert_frame bo_entity_editor">
                <DockPanel Classes="login_alert_inner">
                    <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                        <StackPanel Classes="login_alert_title_row">
                            <Image Classes="login_alert_title_icon"
                                   Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_info_window.png" />
                            <TextBlock x:Name="ImportTitle" Classes="login_alert_title" />
                        </StackPanel>
                    </Border>
                    <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                        <StackPanel Classes="login_alert_action_buttons">
                            <Button Classes="login_alert_action action_secondary" Click="OnImportRemoveClick" ToolTip.Tip="Remover selecionadas">
                                <StackPanel Classes="login_alert_action_content">
                                    <svg:Svg Classes="login_alert_action_icon"
                                             Path="avares://LogicPOS.App/Assets/Images/Documents/botao_eliminar_w.svg" />
                                    <TextBlock Classes="login_alert_action_text" Text="Remover" />
                                </StackPanel>
                            </Button>
                            <Button Classes="login_alert_action" Click="OnImportConfirmClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Importar" />
                                </StackPanel>
                            </Button>
                            <Button Classes="login_alert_action action_secondary" Click="OnImportCancelClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Cancelar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ImportNotice" Classes="bo_import_notice" DockPanel.Dock="Bottom" />
                    <DataGrid x:Name="ImportGrid"
                              Classes="bo_doc_grid bo_import_preview"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False" />
                </DockPanel>
            </Border>
        </Panel>

        <Panel x:Name="PromptOverlay" Classes="login_alert_overlay" IsVisible="False">
            <Border x:Name="PromptFrame" Classes="login_alert_frame bo_entity_prompt">
                <DockPanel Classes="login_alert_inner">
                    <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                        <StackPanel Classes="login_alert_title_row">
                            <Image Classes="login_alert_title_icon"
                                   Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_question_window.png" />
                            <TextBlock x:Name="PromptTitle" Classes="login_alert_title" />
                        </StackPanel>
                    </Border>
                    <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                        <StackPanel Classes="login_alert_action_buttons">
                            <Button Classes="login_alert_action" Click="OnPromptConfirmClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Ok" />
                                </StackPanel>
                            </Button>
                            <Button Classes="login_alert_action action_secondary" Click="OnPromptCancelClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Cancelar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <StackPanel Classes="bo_entity_form">
                        <TextBlock x:Name="PromptLabel" Classes="bo_new_doc_caption" />
                        <TextBox x:Name="PromptValue" Classes="bo_entity_input" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Panel>

        <Panel x:Name="ResultOverlay" Classes="login_alert_overlay" IsVisible="False">
            <Border Classes="login_alert_frame bo_entity_prompt">
                <DockPanel Classes="login_alert_inner">
                    <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                        <StackPanel Classes="login_alert_title_row">
                            <Image Classes="login_alert_title_icon"
                                   Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_info_window.png" />
                            <TextBlock x:Name="ResultTitle" Classes="login_alert_title" Text="Séries" />
                        </StackPanel>
                    </Border>
                    <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                        <StackPanel Classes="login_alert_action_buttons">
                            <Button Classes="login_alert_action" Click="OnResultCloseClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Ok" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Grid Classes="login_alert_body">
                        <Image Classes="login_alert_symbol"
                               Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_info.png" />
                        <TextBlock x:Name="ResultText"
                                   Classes="login_alert_message"
                                   TextWrapping="Wrap" />
                    </Grid>
                </DockPanel>
            </Border>
        </Panel>
    </Panel>
</UserControl>
