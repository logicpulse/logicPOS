<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:views="using:LogicPOS.App.Views"
             x:Class="LogicPOS.App.Views.ReceiptEmissionView"
             Classes="bo_listing">
    <Panel>
        <Border Classes="bo_doc_page">
            <DockPanel>
                <StackPanel Classes="bo_doc_header" DockPanel.Dock="Top">
                    <Border Classes="bo_page_header">
                        <DockPanel>
                            <StackPanel Classes="bo_page_actions" DockPanel.Dock="Right">
                                <Button Classes="bo_page_action" Click="OnPayClick" ToolTip.Tip="Liquidar">
                                    <StackPanel Classes="bo_doc_action_content">
                                        <svg:Svg Classes="bo_doc_action_icon"
                                                 Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_dashboard_emissao_recibos.svg" />
                                        <TextBlock Classes="bo_doc_action_text" Text="Liquidar" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="bo_page_action" Click="OnOpenClick" ToolTip.Tip="Abrir">
                                    <StackPanel Classes="bo_doc_action_content">
                                        <svg:Svg Classes="bo_doc_action_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_ver_w.svg" />
                                        <TextBlock Classes="bo_doc_action_text" Text="Abrir" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel x:Name="PageTitleRow" Classes="bo_page_title_row">
                                <svg:Svg Classes="bo_page_title_icon"
                                         Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_dashboard_emissao_recibos.svg" />
                                <TextBlock Classes="bo_page_title" Text="Emissão Recibos" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DockPanel x:Name="MobileBar" Classes="bo_mobile_bar" IsVisible="False">
                        <Button Classes="bo_mobile_bar_button" DockPanel.Dock="Right" Content="Filtros" Click="OnMobileFilterClick" />
                        <Border Classes="bo_listing_search">
                            <DockPanel>
                                <Button Classes="bo_listing_icon_button" DockPanel.Dock="Right" Click="OnSearchClick" ToolTip.Tip="Procurar">
                                    <svg:Svg Classes="bo_listing_icon" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_pesquisar_b.svg" />
                                </Button>
                                <TextBox x:Name="MobileSearchBox"
                                         Classes="bo_listing_search_box"
                                         PlaceholderText="Procurar"
                                         TextChanged="OnMobileSearchChanged"
                                         KeyUp="OnSearchKeyUp" />
                            </DockPanel>
                        </Border>
                    </DockPanel>
                    <DockPanel x:Name="DesktopTools" Classes="bo_doc_tools">
                        <StackPanel x:Name="ReceiptFilters" Classes="bo_doc_filters" DockPanel.Dock="Left">
                            <views:PeriodRangeField x:Name="Period" />
                            <StackPanel Classes="bo_doc_date_field">
                                <TextBlock Classes="bo_doc_label" Text="Cliente" />
                                <AutoCompleteBox x:Name="CustomerBox" Classes="bo_doc_filter_search" SelectionChanged="OnCustomerFilterChanged" />
                            </StackPanel>
                            <Button Classes="bo_listing_icon_button" Click="OnFilterClick" ToolTip.Tip="Filtrar">
                                <svg:Svg Classes="bo_listing_icon" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_filtro_b.svg" />
                            </Button>
                            <TextBlock x:Name="SelectionLabel" Classes="bo_doc_count_inline" Text="(0) = 0,00" />
                        </StackPanel>
                        <DockPanel Classes="bo_listing_tools">
                            <Border Classes="bo_listing_search">
                                <DockPanel>
                                    <Button Classes="bo_listing_icon_button" DockPanel.Dock="Right" Click="OnSearchClick" ToolTip.Tip="Procurar">
                                        <svg:Svg Classes="bo_listing_icon" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_pesquisar_b.svg" />
                                    </Button>
                                    <TextBox x:Name="SearchBox"
                                             Classes="bo_listing_search_box"
                                             PlaceholderText="Procurar"
                                             TextChanged="OnSearchChanged"
                                             KeyUp="OnSearchKeyUp" />
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </DockPanel>
                    <TextBlock x:Name="Notice" Classes="bo_entity_error" IsVisible="False" Text="" />
                </StackPanel>

                <Border Classes="bo_doc_pager" DockPanel.Dock="Bottom">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="6">
                        <ComboBox x:Name="PageSizeBox" Classes="bo_doc_page_size" SelectedIndex="1" SelectionChanged="OnPageSizeChanged">
                            <ComboBoxItem Content="10" />
                            <ComboBoxItem Content="20" />
                            <ComboBoxItem Content="50" />
                        </ComboBox>
                        <Button Classes="bo_doc_page_button" Content="&lt;&lt;" Click="OnFirstPageClick" />
                        <Button Classes="bo_doc_page_button" Content="&lt;" Click="OnPreviousPageClick" />
                        <TextBlock x:Name="PageLabel" Classes="bo_doc_page_label" Text="1 / 1" />
                        <Button Classes="bo_doc_page_button" Content="&gt;" Click="OnNextPageClick" />
                        <Button Classes="bo_doc_page_button" Content="&gt;&gt;" Click="OnLastPageClick" />
                    </StackPanel>
                </Border>

                <Panel>
                <ListBox x:Name="CardList"
                         Classes="bo_listing_cards"
                         IsVisible="False"
                         SelectionMode="Single"
                         Tapped="OnCardTapped" />
                <DataGrid x:Name="DocumentGrid"
                          x:CompileBindings="False"
                          Classes="bo_doc_grid"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          SelectionMode="Extended"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          SelectionChanged="OnSelectionChanged"
                          DoubleTapped="OnGridDoubleTapped">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="36" MinWidth="36" MaxWidth="36" CanUserSort="False" CanUserReorder="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <CheckBox Classes="bo_doc_pick" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Data do documento" Binding="{Binding DateText}" Width="175" MinWidth="175" IsReadOnly="True" />
                        <DataGridTextColumn Header="Número do Doc." Binding="{Binding Number}" Width="180" MinWidth="180" IsReadOnly="True" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100" MinWidth="100" IsReadOnly="True" />
                        <DataGridTextColumn Header="Entidade" Binding="{Binding CustomerName}" Width="*" MinWidth="140" IsReadOnly="True" />
                        <DataGridTextColumn Header="NIF" Binding="{Binding FiscalNumber}" Width="120" MinWidth="80" IsReadOnly="True" />
                        <DataGridTextColumn Header="Total Final" Binding="{Binding TotalFinalText}" Width="140" MinWidth="140" IsReadOnly="True" />
                        <DataGridTextColumn Header="Valor Pago" Binding="{Binding TotalPaidText}" Width="140" MinWidth="140" IsReadOnly="True" />
                        <DataGridTextColumn Header="Valor em Débito" Binding="{Binding TotalToPayText}" Width="170" MinWidth="170" IsReadOnly="True" />
                        <DataGridTextColumn Header="Documentos Associados" Binding="{Binding RelatedDocuments}" Width="230" MinWidth="230" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="" Width="72" MinWidth="72" MaxWidth="72" CanUserSort="False" CanUserReorder="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="0">
                                        <Button Classes="bo_doc_icon_button" Click="OnRowViewClick" ToolTip.Tip="Ver">
                                            <svg:Svg Classes="bo_doc_row_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_ver_b.svg" />
                                        </Button>
                                        <Button Classes="bo_doc_icon_button" Click="OnRowPrintClick" ToolTip.Tip="Imprimir">
                                            <svg:Svg Classes="bo_doc_row_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_imprimir_b.svg" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <views:ListingBusy x:Name="Busy" />
                </Panel>
            </DockPanel>
        </Border>

        <Panel x:Name="FilterSheet" Classes="login_alert_overlay" IsVisible="False">
            <Border Classes="login_alert_frame bo_mobile_sheet">
                <DockPanel Classes="login_alert_inner">
                    <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                        <StackPanel Classes="login_alert_title_row">
                            <TextBlock Classes="login_alert_title" Text="Filtros" />
                        </StackPanel>
                    </Border>
                    <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                        <StackPanel Classes="login_alert_action_buttons">
                            <Button Classes="login_alert_action" Click="OnMobileFilterApplyClick">
                                <TextBlock Classes="login_alert_action_text" Text="Filtrar" />
                            </Button>
                            <Button Classes="login_alert_action" Click="OnMobileFilterCloseClick">
                                <TextBlock Classes="login_alert_action_text" Text="Fechar" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel x:Name="FilterSheetHost" Classes="bo_entity_form" Spacing="12" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <Panel x:Name="PayOverlay" Classes="login_alert_overlay" IsVisible="False">
            <Border x:Name="PayFrame" Classes="login_alert_frame bo_email_dialog bo_receipt_pay_dialog">
                <DockPanel Classes="login_alert_inner">
                    <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Classes="login_alert_title_row">
                                <Image Classes="login_alert_title_icon"
                                       Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_question_window.png" />
                                <TextBlock x:Name="PayTitle" Classes="login_alert_title" Text="Liquidar Faturas" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="bo_window_button" Click="OnPayCancelClick" ToolTip.Tip="Fechar">
                                <TextBlock Text="✕" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>
                    <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                        <DockPanel>
                            <StackPanel Classes="login_alert_action_buttons" DockPanel.Dock="Right">
                                <Button x:Name="PayOkButton" Classes="login_alert_action" Click="OnPayOkClick">
                                    <StackPanel Classes="login_alert_action_content">
                                        <Image Classes="login_alert_action_icon" Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                                        <TextBlock Classes="login_alert_action_text" Text="OK" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="login_alert_action" Click="OnPayCancelClick">
                                    <StackPanel Classes="login_alert_action_content">
                                        <Image Classes="login_alert_action_icon" Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                                        <TextBlock Classes="login_alert_action_text" Text="Cancelar" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="PayError" Classes="bo_entity_error" VerticalAlignment="Center" Text="" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel Classes="bo_entity_form" Spacing="10">
                            <TextBlock Classes="bo_new_doc_caption" Text="Método de pagamento" />
                            <ComboBox x:Name="PaymentMethodBox" Classes="bo_entity_input" HorizontalAlignment="Stretch" />
                            <StackPanel x:Name="ExchangeFields" Spacing="10">
                                <TextBlock Classes="bo_new_doc_caption" Text="Moeda" />
                                <ComboBox x:Name="CurrencyBox" Classes="bo_entity_input" HorizontalAlignment="Stretch" SelectionChanged="OnCurrencyChanged" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Câmbio" />
                                <TextBox x:Name="ExchangeRate" Classes="bo_entity_input bo_numeric" TextChanged="OnAmountChanged" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Total (sistema)" />
                                <TextBox x:Name="SystemAmount" Classes="bo_entity_input" IsReadOnly="True" />
                            </StackPanel>
                            <TextBlock Classes="bo_new_doc_caption" Text="Total entregue" />
                            <TextBox x:Name="TotalPaid" Classes="bo_entity_input bo_numeric" TextChanged="OnAmountChanged" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Data" />
                            <CalendarDatePicker x:Name="PayDate" Classes="bo_entity_input" HorizontalAlignment="Stretch" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Notas" />
                            <TextBox x:Name="PayNotes" Classes="bo_entity_input" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>
    </Panel>
</UserControl>
