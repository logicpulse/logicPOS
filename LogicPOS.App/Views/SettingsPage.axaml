<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="LogicPOS.App.Views.SettingsPage">
    <Border Classes="bo_doc_page">
        <DockPanel>
            <StackPanel Classes="bo_doc_header" DockPanel.Dock="Top">
                <Border Classes="bo_page_header">
                    <StackPanel Classes="bo_page_title_row">
                        <svg:Svg x:Name="TitleIcon" Classes="bo_page_title_icon" IsVisible="False" />
                        <TextBlock x:Name="TitleText" Classes="bo_page_title" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="Notice" Classes="bo_entity_notice" />
                <ScrollViewer Classes="bo_settings_tabs" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Border Classes="bo_article_tab_strip">
                        <StackPanel x:Name="TabBar" Classes="bo_entity_tab_headers" />
                    </Border>
                </ScrollViewer>
            </StackPanel>
            <Border Classes="bo_settings_footer" DockPanel.Dock="Bottom">
                <Button Classes="login_alert_action action_primary" Click="OnSaveClick">
                    <StackPanel Classes="login_alert_action_content">
                        <Image Classes="login_alert_action_icon"
                               Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                        <TextBlock Classes="login_alert_action_text" Text="Guardar" />
                    </StackPanel>
                </Button>
            </Border>
            <ScrollViewer>
                <Panel x:Name="FieldsHost" Margin="8,4,8,12" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
