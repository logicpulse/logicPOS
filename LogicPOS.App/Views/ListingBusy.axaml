<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:LogicPOS.App.Views"
             x:Class="LogicPOS.App.Views.ListingBusy"
             Classes="bo_listing_busy_host"
             IsVisible="False"
             IsHitTestVisible="False">
    <Panel x:Name="Scrim" Classes="bo_listing_busy">
        <Border Classes="glass_card glass_compact">
        <StackPanel Classes="bo_listing_busy_box">
            <views:LogoLoader Width="30" Height="30" HorizontalAlignment="Center" />
            <TextBlock x:Name="Label" Classes="bo_listing_busy_label" Text="A carregar..." />
        </StackPanel>
        </Border>
    </Panel>
</UserControl>
