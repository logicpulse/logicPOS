<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:LogicPOS.App.Views"
             x:Class="LogicPOS.App.Views.ListingBusy"
             Classes="bo_listing_busy_host"
             IsVisible="False"
             IsHitTestVisible="False">
    <Panel x:Name="Scrim" Classes="bo_listing_busy">
        <Border x:Name="Card" Classes="glass_card glass_compact">
            <StackPanel Classes="bo_listing_busy_box">
                <views:LogoLoader x:Name="Logo" Width="74" Height="74" HorizontalAlignment="Center" />
                <TextBlock x:Name="Label" Classes="startup_status" Text="A carregar..." />
                <ProgressBar x:Name="Bar" Classes="startup_progress" IsIndeterminate="True" IsVisible="False" />
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
