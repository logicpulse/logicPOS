<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LogicPOS.App.Views"
        x:Class="LogicPOS.App.Views.LoginShellWindow"
        Classes="login_window"
        Title="logicpos"
        Icon="avares://LogicPOS.App/Assets/application.ico"
        WindowState="FullScreen"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="#111111">
    <Panel>
        <views:LoginWindow x:Name="Login" />
        <Border x:Name="DevBanner"
                Classes="dev_edition_banner"
                IsVisible="False">
            <TextBlock Classes="dev_edition_banner_text"
                       Text="Versão de desenvolvimento — não utilize para emitir documentos fiscais verdadeiros."
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
        </Border>
    </Panel>
</Window>
