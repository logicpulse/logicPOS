<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LogicPOS.App.Views.PaymentWindow"
        Classes="pos_pay_window"
        Title="Pagamentos"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False">
    <Panel>
        <Panel Classes="login_alert_overlay" IsVisible="False" />
        <Border Classes="login_alert_frame bo_pay_dialog">
            <DockPanel Classes="login_alert_inner">
                <Border Classes="login_alert_titlebar pos_pay_titlebar" DockPanel.Dock="Top">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Classes="login_alert_title_row">
                            <Image Classes="login_alert_title_icon"
                                   Source="avares://LogicPOS.App/Assets/Images/Pos/Payments/icon_window_payments.png" />
                            <TextBlock Classes="login_alert_title" Text="Pagamentos" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="bo_window_button" Click="OnCancelClick" ToolTip.Tip="Fechar">
                            <TextBlock Text="✕" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <Border Classes="pos_pay_footer" DockPanel.Dock="Bottom">
                    <UniformGrid Classes="pos_pay_actions" Columns="7" Rows="1">
                        <Button Classes="login_alert_action pos_pay_action" Click="OnInvoiceClick">
                            <StackPanel Classes="login_alert_action_content">
                                <Image Classes="login_alert_action_icon"
                                       Source="avares://LogicPOS.App/Assets/Images/Pos/Payments/icon_pos_toolbar_finance_document.png" />
                                <TextBlock Classes="login_alert_action_text" Text="Fatura" />
                            </StackPanel>
                        </Button>
                        <Button Classes="login_alert_action pos_pay_action" Click="OnClearCustomerClick">
                            <StackPanel Classes="login_alert_action_content">
                                <Image Classes="login_alert_action_icon"
                                       Source="avares://LogicPOS.App/Assets/Images/Pos/Payments/icon_pos_nav_delete.png" />
                                <TextBlock Classes="login_alert_action_text" Text="Limpar" />
                            </StackPanel>
                        </Button>
                        <Button Classes="login_alert_action pos_pay_action" Click="OnNewCustomerClick">
                            <StackPanel Classes="login_alert_action_content">
                                <Image Classes="login_alert_action_icon"
                                       Source="avares://LogicPOS.App/Assets/Images/Pos/Payments/icon_pos_clients.png" />
                                <TextBlock Classes="login_alert_action_text" Text="Novo Cli." />
                            </StackPanel>
                        </Button>
                        <Button x:Name="FullPaymentButton" Classes="login_alert_action pos_pay_action selected">
                            <StackPanel Classes="login_alert_action_content">
                                <Image Classes="login_alert_action_icon"
                                       Source="avares://LogicPOS.App/Assets/Images/Pos/Payments/icon_pos_payment_full.png" />
                                <TextBlock Classes="login_alert_action_text" Text="Pag. Total" />
                            </StackPanel>
                        </Button>
                        <Button Classes="login_alert_action pos_pay_action" Click="OnPartialPaymentClick">
                            <StackPanel Classes="login_alert_action_content">
                                <Image Classes="login_alert_action_icon"
                                       Source="avares://LogicPOS.App/Assets/Images/Pos/Payments/icon_pos_payment_partial.png" />
                                <TextBlock Classes="login_alert_action_text" Text="Pag. Parcial" />
                            </StackPanel>
                        </Button>
                        <Button Classes="login_alert_action pos_pay_action pos_pay_action_ok" Click="OnConfirmClick">
                            <StackPanel Classes="login_alert_action_content">
                                <Image Classes="login_alert_action_icon"
                                       Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                                <TextBlock Classes="login_alert_action_text" Text="Ok" />
                            </StackPanel>
                        </Button>
                        <Button Classes="login_alert_action pos_pay_action" Click="OnCancelClick">
                            <StackPanel Classes="login_alert_action_content">
                                <Image Classes="login_alert_action_icon"
                                       Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                                <TextBlock Classes="login_alert_action_text" Text="Cancelar" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Border>

                <ScrollViewer Classes="pos_pay_scroll">
                    <StackPanel Classes="pos_pay_body">
                        <Grid ColumnDefinitions="350,*" Margin="0,0,0,10">
                            <Grid x:Name="MethodGrid"
                                  ColumnDefinitions="112,112,112"
                                  RowDefinitions="76,76,76" />
                            <Border Grid.Column="1" Classes="pos_pay_totals">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="pos_pay_totals_title" Text="Resumo do Pagamento" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="pos_pay_caption" Text="Documento" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DocumentTypeValue" Grid.Column="1" Classes="pos_pay_amount" Text="FS" />
                                    </Grid>
                                    <Border Classes="pos_pay_due_row">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="pos_pay_due_label" Text="Total a pagar" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TotalValue" Grid.Column="1" Classes="pos_pay_due_value" Text="0" />
                                        </Grid>
                                    </Border>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="pos_pay_caption" Text="Total entregue" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DeliveryValue" Grid.Column="1" Classes="pos_pay_amount" Text="0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="pos_pay_caption" Text="Troco" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ChangeValue" Grid.Column="1" Classes="pos_pay_change" Text="0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Classes="pos_pay_customer_section">
                            <StackPanel>
                                <Border Classes="pos_pay_customer_header">
                                    <TextBlock Classes="pos_pay_customer_header_text" Text="Dados do Cliente" />
                                </Border>
                                <StackPanel Classes="pos_pay_customer_form">
                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Classes="pos_pay_label" Text="NIF" />
                                            <TextBox x:Name="FiscalNumber" Classes="pos_pay_field" KeyDown="OnCustomerSearchKey" TextChanged="OnCustomerTextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Classes="pos_pay_label" Text="Número do Cartão de Cliente" />
                                            <TextBox x:Name="CardNumber" Classes="pos_pay_field" TextChanged="OnCardNumberChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,160">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Classes="pos_pay_label" Text="Cliente" />
                                            <TextBox x:Name="CustomerName" Classes="pos_pay_field" KeyDown="OnCustomerSearchKey" TextChanged="OnCustomerTextChanged" />
                                            <TextBlock x:Name="CustomerSearchNotice" Classes="bo_entity_error" IsVisible="False" />
                                            <Popup x:Name="CustomerSuggest"
                                                   Placement="Bottom"
                                                   IsLightDismissEnabled="True">
                                                <Border Classes="bo_new_doc_suggest" MinWidth="280">
                                                    <ScrollViewer MaxHeight="180">
                                                        <StackPanel x:Name="CustomerSuggestList" />
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Classes="pos_pay_label" Text="Desconto" />
                                            <TextBox x:Name="Discount" Classes="pos_pay_field" Text="0,00" TextChanged="OnDiscountChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel>
                                        <TextBlock Classes="pos_pay_label" Text="Morada" />
                                        <TextBox x:Name="Address" Classes="pos_pay_field" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="pos_pay_label" Text="Localidade" />
                                        <TextBox x:Name="Locality" Classes="pos_pay_field" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="140,*,*">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Classes="pos_pay_label" Text="Código-Postal" />
                                            <TextBox x:Name="ZipCode" Classes="pos_pay_field" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0">
                                            <TextBlock Classes="pos_pay_label" Text="Cidade" />
                                            <TextBox x:Name="City" Classes="pos_pay_field" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock Classes="pos_pay_label" Text="País" />
                                            <TextBox x:Name="Country" Classes="pos_pay_field" IsReadOnly="True" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Classes="pos_pay_label" Text="Notas" />
                                        <TextBox x:Name="Notes" Classes="pos_pay_field" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Panel x:Name="NoticeOverlay" Classes="login_alert_overlay" IsVisible="False">
            <Border Classes="login_alert_frame login_alert_message_box">
                <DockPanel Classes="login_alert_inner">
                    <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                        <StackPanel Classes="login_alert_title_row">
                            <Image x:Name="NoticeIcon" Classes="login_alert_title_icon" />
                            <TextBlock x:Name="NoticeTitle" Classes="login_alert_title" />
                        </StackPanel>
                    </Border>
                    <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                        <StackPanel Classes="login_alert_action_buttons" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="NoticeYesButton" Classes="login_alert_action" IsVisible="False" Click="OnNoticeYesClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_yes.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Sim" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NoticeNoButton" Classes="login_alert_action" IsVisible="False" Click="OnNoticeCloseClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Não" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NoticeOkButton" Classes="login_alert_action" Click="OnNoticeCloseClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Ok" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Grid Classes="login_alert_body">
                        <Image x:Name="NoticeSymbol" Classes="login_alert_symbol" />
                        <TextBlock x:Name="NoticeMessage" Classes="login_alert_message" TextWrapping="Wrap" />
                    </Grid>
                </DockPanel>
            </Border>
        </Panel>

        <Panel x:Name="PartialOverlay" Classes="login_alert_overlay" IsVisible="False">
            <Border Classes="login_alert_frame" MinWidth="420" MaxWidth="560" Width="NaN" Height="NaN" MaxHeight="460">
                <DockPanel Classes="login_alert_inner">
                    <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                        <TextBlock Classes="login_alert_title" Text="Pagamento parcial" />
                    </Border>
                    <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                        <StackPanel Classes="login_alert_action_buttons">
                            <Button Classes="login_alert_action" Click="OnPartialConfirmClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Ok" />
                                </StackPanel>
                            </Button>
                            <Button Classes="login_alert_action" Click="OnPartialCancelClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Cancelar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel x:Name="PartialLines" Classes="bo_entity_form" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <Panel x:Name="CashOverlay" Classes="login_alert_overlay" IsVisible="False">
            <Border Classes="login_alert_frame" MinWidth="420" MaxWidth="540" Width="NaN" Height="NaN" MaxHeight="530">
                <DockPanel Classes="login_alert_inner">
                    <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                        <StackPanel Classes="login_alert_title_row">
                            <Image Classes="login_alert_title_icon"
                                   Source="avares://LogicPOS.App/Assets/Images/Pos/Payments/icon_window_payments.png" />
                            <TextBlock Classes="login_alert_title" Text="Dinheiro requisitado" />
                        </StackPanel>
                    </Border>
                    <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                        <StackPanel Classes="login_alert_action_buttons">
                            <Button Classes="login_alert_action" Click="OnCashOkClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_yes.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Ok" />
                                </StackPanel>
                            </Button>
                            <Button Classes="login_alert_action" Click="OnCashCancelClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Cancelar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Grid Classes="pos_price_pad" RowDefinitions="Auto,*" ColumnDefinitions="108,*,108">
                        <TextBox x:Name="CashEntry" Grid.ColumnSpan="3" Classes="pos_price_entry" IsReadOnly="True" />
                        <Grid Grid.Row="1" RowDefinitions="*,*,*,*,*">
                            <Button Classes="pos_price_money" Content="0,05 €" Tag="0.05" Click="OnCashMoneyClick" />
                            <Button Classes="pos_price_money" Grid.Row="1" Content="0,10 €" Tag="0.10" Click="OnCashMoneyClick" />
                            <Button Classes="pos_price_money" Grid.Row="2" Content="0,20 €" Tag="0.20" Click="OnCashMoneyClick" />
                            <Button Classes="pos_price_money" Grid.Row="3" Content="0,50 €" Tag="0.50" Click="OnCashMoneyClick" />
                            <Button Classes="pos_price_money" Grid.Row="4" Content="1,00 €" Tag="1.00" Click="OnCashMoneyClick" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="6,0" ColumnDefinitions="*,*,*" RowDefinitions="*,*,*,*">
                            <Button Classes="pos_price_digit" Content="7" Tag="7" Click="OnCashDigitClick" />
                            <Button Classes="pos_price_digit" Grid.Column="1" Content="8" Tag="8" Click="OnCashDigitClick" />
                            <Button Classes="pos_price_digit" Grid.Column="2" Content="9" Tag="9" Click="OnCashDigitClick" />
                            <Button Classes="pos_price_digit" Grid.Row="1" Content="4" Tag="4" Click="OnCashDigitClick" />
                            <Button Classes="pos_price_digit" Grid.Row="1" Grid.Column="1" Content="5" Tag="5" Click="OnCashDigitClick" />
                            <Button Classes="pos_price_digit" Grid.Row="1" Grid.Column="2" Content="6" Tag="6" Click="OnCashDigitClick" />
                            <Button Classes="pos_price_digit" Grid.Row="2" Content="1" Tag="1" Click="OnCashDigitClick" />
                            <Button Classes="pos_price_digit" Grid.Row="2" Grid.Column="1" Content="2" Tag="2" Click="OnCashDigitClick" />
                            <Button Classes="pos_price_digit" Grid.Row="2" Grid.Column="2" Content="3" Tag="3" Click="OnCashDigitClick" />
                            <Button Classes="pos_price_digit" Grid.Row="3" Content="0" Tag="0" Click="OnCashDigitClick" />
                            <Button Classes="pos_price_digit" Grid.Row="3" Grid.Column="1" Content="," Tag="," Click="OnCashDigitClick" />
                            <Button Classes="pos_price_digit" Grid.Row="3" Grid.Column="2" Content="CE" Click="OnCashClearClick" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="*,*,*,*,*">
                            <Button Classes="pos_price_money" Content="5,00 €" Tag="5.00" Click="OnCashMoneyClick" />
                            <Button Classes="pos_price_money" Grid.Row="1" Content="10,00 €" Tag="10.00" Click="OnCashMoneyClick" />
                            <Button Classes="pos_price_money" Grid.Row="2" Content="20,00 €" Tag="20.00" Click="OnCashMoneyClick" />
                            <Button Classes="pos_price_money" Grid.Row="3" Content="50,00 €" Tag="50.00" Click="OnCashMoneyClick" />
                            <Button Classes="pos_price_money" Grid.Row="4" Content="100,00 €" Tag="100.00" Click="OnCashMoneyClick" />
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>
        </Panel>
    </Panel>
</Window>
