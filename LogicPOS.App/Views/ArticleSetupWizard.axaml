<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:views="using:LogicPOS.App.Views"
             x:Class="LogicPOS.App.Views.ArticleSetupWizard">
    <Panel>
        <Border Classes="login_alert_frame bo_fiscal_wizard">
            <DockPanel Classes="login_alert_inner">
                <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                    <StackPanel Classes="login_alert_title_row">
                        <Image Classes="login_alert_title_icon"
                               Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_window_documents.png" />
                        <TextBlock Classes="login_alert_title" Text="Criar primeiro artigo" />
                    </StackPanel>
                </Border>

                <Border Classes="login_alert_actions bo_fiscal_wizard_actions" DockPanel.Dock="Bottom">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Classes="login_alert_action_buttons">
                            <Button x:Name="BackButton" Classes="login_alert_action action_secondary" Click="OnBackClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <svg:Svg Classes="login_alert_action_icon"
                                             Path="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_back.svg" />
                                    <TextBlock Classes="login_alert_action_text" Text="Voltar" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NextButton" Classes="login_alert_action" Click="OnNextClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <svg:Svg Classes="login_alert_action_icon"
                                             Path="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_next.svg" />
                                    <TextBlock Classes="login_alert_action_text" Text="Seguinte" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FinishButton" Classes="login_alert_action" Click="OnFinishClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Criar" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CloseButton" Classes="login_alert_action action_secondary" Click="OnCloseClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Fechar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="Notice" Classes="bo_entity_error" Margin="12,0,12,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <Border Classes="bo_fiscal_wizard_tabs_host" DockPanel.Dock="Top">
                    <StackPanel x:Name="TabBar" Classes="bo_fiscal_wizard_tabs" />
                </Border>

                <ScrollViewer Classes="bo_fiscal_wizard_scroll">
                    <Border Classes="bo_article_section bo_wizard_card">
                        <Panel>
                            <StackPanel x:Name="FamilyStep" Classes="bo_fiscal_wizard_form">
                                <Border Classes="bo_article_section_header bo_wizard_card_header">
                                    <StackPanel Classes="bo_article_section_title_row">
                                        <svg:Svg Classes="bo_article_section_icon" Path="avares://LogicPOS.App/Assets/Images/Articles/icon_layers_g.svg" />
                                        <TextBlock Classes="bo_article_section_title" Text="Família" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Classes="bo_fiscal_wizard_step_hint"
                                           Text="A família agrupa os artigos no posto. Pode usar «Geral» se ainda não tiver categorias."
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="bo_fiscal_wizard_caption" Text="Designação" />
                                <TextBox x:Name="FamilyBox" Classes="bo_entity_input" />
                            </StackPanel>
                            <StackPanel x:Name="SubfamilyStep" Classes="bo_fiscal_wizard_form" IsVisible="False">
                                <Border Classes="bo_article_section_header bo_wizard_card_header">
                                    <StackPanel Classes="bo_article_section_title_row">
                                        <svg:Svg Classes="bo_article_section_icon" Path="avares://LogicPOS.App/Assets/Images/Articles/icon_layers_g.svg" />
                                        <TextBlock Classes="bo_article_section_title" Text="Subfamília" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Classes="bo_fiscal_wizard_step_hint"
                                           Text="A subfamília fica dentro da família e é obrigatória para criar o artigo."
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="bo_fiscal_wizard_caption" Text="Designação" />
                                <TextBox x:Name="SubfamilyBox" Classes="bo_entity_input" />
                            </StackPanel>
                            <StackPanel x:Name="ArticleStep" Classes="bo_fiscal_wizard_form" IsVisible="False">
                                <Border Classes="bo_article_section_header bo_wizard_card_header">
                                    <StackPanel Classes="bo_article_section_title_row">
                                        <svg:Svg Classes="bo_article_section_icon" Path="avares://LogicPOS.App/Assets/Images/Articles/icon_tag_g.svg" />
                                        <TextBlock Classes="bo_article_section_title" Text="Artigo" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Classes="bo_fiscal_wizard_step_hint"
                                           Text="Só precisa do nome e do preço. O código, o IVA e as unidades são preenchidos automaticamente."
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="bo_fiscal_wizard_caption" Text="Designação" />
                                <TextBox x:Name="ArticleBox" Classes="bo_entity_input" />
                                <TextBlock Classes="bo_fiscal_wizard_caption" Text="Preço" />
                                <TextBox x:Name="PriceBox" Classes="bo_entity_input" />
                            </StackPanel>
                        </Panel>
                    </Border>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <views:ListingBusy x:Name="Busy" />
    </Panel>
</UserControl>
