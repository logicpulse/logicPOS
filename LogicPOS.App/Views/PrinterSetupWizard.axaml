<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:views="using:LogicPOS.App.Views"
             x:Class="LogicPOS.App.Views.PrinterSetupWizard">
    <Panel>
        <Border Classes="login_alert_frame bo_fiscal_wizard">
            <DockPanel Classes="login_alert_inner">
                <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                    <StackPanel Classes="login_alert_title_row">
                        <Image Classes="login_alert_title_icon"
                               Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_info_window.png" />
                        <TextBlock Classes="login_alert_title" Text="Impressora do terminal" />
                    </StackPanel>
                </Border>

                <Border Classes="login_alert_actions bo_fiscal_wizard_actions" DockPanel.Dock="Bottom">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Classes="login_alert_action_buttons">
                            <Button x:Name="TestButton" Classes="login_alert_action action_secondary" Click="OnTestClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <svg:Svg Classes="login_alert_action_icon"
                                             Path="avares://LogicPOS.App/Assets/Images/Pdf/pdf_print.svg" />
                                    <TextBlock Classes="login_alert_action_text" Text="Imprimir teste" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FinishButton" Classes="login_alert_action" Click="OnFinishClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Associar" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CloseButton" Classes="login_alert_action action_secondary" Click="OnCloseClick">
                                <StackPanel Classes="login_alert_action_content">
                                    <Image Classes="login_alert_action_icon"
                                           Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                                    <TextBlock Classes="login_alert_action_text" Text="Fechar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="Notice" Classes="bo_entity_error" Margin="12,0,12,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <ScrollViewer Classes="bo_fiscal_wizard_scroll">
                    <Border Classes="bo_article_section bo_wizard_card">
                        <StackPanel Classes="bo_fiscal_wizard_form">
                            <Border Classes="bo_article_section_header bo_wizard_card_header">
                                <StackPanel Classes="bo_article_section_title_row">
                                    <svg:Svg Classes="bo_article_section_icon" Path="avares://LogicPOS.App/Assets/Images/Articles/icon_printer_g.svg" />
                                    <TextBlock Classes="bo_article_section_title" Text="Impressora" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="Hint" Classes="bo_fiscal_wizard_step_hint" TextWrapping="Wrap" />
                            <TextBlock Classes="bo_fiscal_wizard_caption" Text="Tipo de impressora" />
                            <ComboBox x:Name="TypeBox" Classes="bo_entity_input" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnTypeChanged" />
                            <TextBlock Classes="bo_fiscal_wizard_caption" Text="Impressora do Windows" />
                            <ComboBox x:Name="PrinterBox" Classes="bo_entity_input" HorizontalAlignment="Stretch" />
                            <TextBlock Classes="bo_fiscal_wizard_caption" Text="Tamanho do papel" />
                            <ComboBox x:Name="PaperBox" Classes="bo_entity_input" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <views:ListingBusy x:Name="Busy" />
    </Panel>
</UserControl>
