<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:views="using:LogicPOS.App.Views"
             x:Class="LogicPOS.App.Views.NewDocumentWindow"
             Classes="bo_new_doc">
    <Grid>
    <Panel x:Name="DocumentShell" Classes="bo_dialog_shell">
    <Border x:Name="DocumentFrame" Classes="login_alert_frame"
            Background="#FFFFFF"
            BorderBrush="#D0D5DA"
            BorderThickness="1"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <DockPanel Background="#FFFFFF">
            <Border x:Name="DocumentTitlebar"
                    Classes="login_alert_titlebar bo_dialog_drag"
                    DockPanel.Dock="Top"
                    PointerPressed="OnDocumentTitlePointerPressed"
                    PointerMoved="OnDocumentTitlePointerMoved"
                    PointerReleased="OnDocumentTitlePointerReleased"
                    PointerCaptureLost="OnDocumentTitlePointerCaptureLost">
                <DockPanel>
                    <Button Classes="bo_window_button" DockPanel.Dock="Right" Click="OnCancelClick"
                            ToolTip.Tip="Fechar">
                        <svg:Svg Classes="bo_window_icon"
                                 Path="avares://LogicPOS.App/Assets/Images/BackOffice/botao_fechar_w.svg" />
                    </Button>
                    <StackPanel Classes="login_alert_title_row">
                        <svg:Svg Classes="login_alert_title_icon"
                                 Path="avares://LogicPOS.App/Assets/Images/Listing/botao_novo_w.svg" />
                        <TextBlock Classes="login_alert_title" Text="Novo documento" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Classes="bo_new_doc_options">
                        <CheckBox x:Name="DraftBox" Classes="bo_new_doc_draft" Content="Guardar como rascunho" IsCheckedChanged="OnDraftChanged" />
                        <CheckBox x:Name="TransportBox" Classes="bo_new_doc_draft" Content="Dados de transporte" IsVisible="False" IsCheckedChanged="OnTransportChanged" />
                        <Button x:Name="TransportButton" Classes="bo_line_icon bo_transport_icon" IsVisible="False" Click="OnOpenTransportClick" ToolTip.Tip="Editar dados de transporte">
                            <svg:Svg Classes="bo_line_icon_image bo_transport_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_editar_b.svg" />
                        </Button>
                    </StackPanel>
                <StackPanel x:Name="DocumentActions" Classes="login_alert_action_buttons">
                    <Button Classes="login_alert_action bo_new_doc_preview" Click="OnPreviewClick">
                        <StackPanel Classes="login_alert_action_content">
                            <svg:Svg Classes="login_alert_action_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_imprimir_w.svg" />
                            <TextBlock Classes="login_alert_action_text" Text="Pré-visualizar" />
                        </StackPanel>
                    </Button>
                    <Button Classes="login_alert_action" Click="OnIssueClick">
                        <StackPanel Classes="login_alert_action_content">
                            <Image Classes="login_alert_action_icon"
                                   Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                            <TextBlock x:Name="IssueLabel" Classes="login_alert_action_text" Text="Emitir A4" />
                        </StackPanel>
                    </Button>
                    <Button Classes="login_alert_action" Click="OnCancelClick">
                        <StackPanel Classes="login_alert_action_content">
                            <Image Classes="login_alert_action_icon"
                                   Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                            <TextBlock Classes="login_alert_action_text" Text="Cancelar" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                </DockPanel>
            </Border>
            <DockPanel Classes="bo_new_doc_body">
                <ScrollViewer x:Name="HeaderScroll"
                              Classes="bo_new_doc_header_scroll"
                              DockPanel.Dock="Top"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                <Grid x:Name="HeaderFields" Classes="bo_new_doc_fields" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <StackPanel>
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_informacoes_fiscais_tipos_documentos_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Tipo de documento" />
                        </StackPanel>
                        <ComboBox x:Name="TypeBox" Classes="bo_new_doc_combo" SelectionChanged="OnTypeChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_informacoes_fiscais_series_documentos_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Série" />
                        </StackPanel>
                        <Border Classes="bo_new_doc_value_box">
                            <TextBlock x:Name="SeriesLabel" Classes="bo_new_doc_value" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_calendario_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Data" />
                        </StackPanel>
                        <Border Classes="bo_new_doc_value_box">
                            <TextBlock x:Name="DateLabel" Classes="bo_new_doc_value" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_informacoes_fiscais_condicoes_pagamento_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Condições de pagamento" />
                        </StackPanel>
                        <ComboBox x:Name="PaymentBox" Classes="bo_new_doc_combo" />
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_outras_tabelas_moedas_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Moeda" />
                        </StackPanel>
                        <ComboBox x:Name="CurrencyBox" Classes="bo_new_doc_combo" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_origem_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Documento de origem" />
                        </StackPanel>
                        <DockPanel Classes="bo_touch_row">
                            <Button x:Name="OriginClearButton"
                                    Classes="bo_lookup_clear"
                                    Content="×"
                                    DockPanel.Dock="Right"
                                    IsVisible="False"
                                    Click="OnClearOriginClick"
                                    ToolTip.Tip="Limpar" />
                            <AutoCompleteBox x:Name="OriginBox"
                                            Classes="bo_new_doc_search"
                                            PlaceholderText="Nº, cliente ou NIF..."
                                            SelectionChanged="OnOriginChanged"
                                            TextChanged="OnOriginTextChanged" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_copiar_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Copiar outro documento" />
                        </StackPanel>
                        <DockPanel Classes="bo_touch_row">
                            <Button x:Name="CopyClearButton"
                                    Classes="bo_lookup_clear"
                                    Content="×"
                                    DockPanel.Dock="Right"
                                    IsVisible="False"
                                    Click="OnClearCopyClick"
                                    ToolTip.Tip="Limpar" />
                            <AutoCompleteBox x:Name="CopyBox"
                                            Classes="bo_new_doc_search"
                                            PlaceholderText="Nº, cliente ou NIF..."
                                            SelectionChanged="OnCopyChanged"
                                            TextChanged="OnCopyTextChanged" />
                        </DockPanel>
                    </StackPanel>
                    <Border Grid.Row="2" Grid.ColumnSpan="4" Classes="bo_new_doc_customer_card">
                        <Grid ColumnDefinitions="*,180,Auto">
                            <StackPanel>
                                <StackPanel Classes="bo_new_doc_label">
                                    <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_clientes_b.svg" />
                                    <TextBlock Classes="bo_new_doc_caption" Text="Cliente" />
                                </StackPanel>
                                <TextBox x:Name="CustomerName"
                                         Classes="bo_line_editor_input"
                                         PlaceholderText="Consumidor Final"
                                         KeyDown="OnCustomerSearchKey"
                                         TextChanged="OnCustomerEdited" />
                                <Popup x:Name="CustomerSuggest"
                                       Placement="Bottom"
                                       IsLightDismissEnabled="True">
                                    <Border Classes="bo_new_doc_suggest" MinWidth="360">
                                        <ScrollViewer MaxHeight="220">
                                            <StackPanel x:Name="CustomerSuggestList" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <StackPanel Classes="bo_new_doc_label">
                                    <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_informacoes_fiscais_b.svg" />
                                    <TextBlock Classes="bo_new_doc_caption" Text="NIF" />
                                </StackPanel>
                                <TextBox x:Name="CustomerFiscal"
                                         Classes="bo_line_editor_input bo_numeric"
                                         KeyDown="OnCustomerSearchKey"
                                         TextChanged="OnCustomerEdited" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Classes="bo_new_doc_customer_actions">
                                <Button Classes="bo_line_icon" Click="OnCustomerSearchClick" ToolTip.Tip="Procurar">
                                    <svg:Svg Classes="bo_line_icon_image" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_pesquisar_b.svg" />
                                </Button>
                                <Button Classes="bo_line_icon" Click="OnNewCustomerClick" ToolTip.Tip="Novo">
                                    <svg:Svg Classes="bo_line_icon_image" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_novo_b.svg" />
                                </Button>
                                <Button x:Name="CustomerEditButton" Classes="bo_line_icon" IsVisible="False" Click="OnEditCustomerClick" ToolTip.Tip="Editar">
                                    <svg:Svg Classes="bo_line_icon_image" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_editar_b.svg" />
                                </Button>
                                <Button Classes="bo_line_icon" Click="OnClearCustomerClick" ToolTip.Tip="Limpar">
                                    <svg:Svg Classes="bo_line_icon_image" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_limpar_b.svg" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="4">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_editar_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Notas" />
                        </StackPanel>
                        <TextBox x:Name="NotesBox"
                                 Classes="bo_new_doc_notes"
                                 PlaceholderText="Introduza notas sobre o documento..." />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
                <TextBlock x:Name="ErrorLabel" Classes="bo_new_doc_error" DockPanel.Dock="Bottom" IsVisible="False" />
                <Border Classes="bo_new_doc_articles">
                    <DockPanel>
                        <Border Classes="bo_new_doc_articles_header" DockPanel.Dock="Top">
                            <StackPanel Classes="bo_new_doc_articles_title_row">
                                <svg:Svg Classes="bo_new_doc_articles_icon"
                                         Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_artigos_artigos.svg" />
                                <TextBlock Classes="bo_new_doc_ship_title" Text="Artigos" />
                            </StackPanel>
                        </Border>
                        <StackPanel DockPanel.Dock="Bottom" Classes="bo_new_doc_articles_footer">
                            <DockPanel Classes="bo_new_doc_search">
                                <StackPanel Classes="bo_new_doc_article_tools" DockPanel.Dock="Right">
                                    <Button Classes="bo_new_doc_tool" Click="OnNewArticleClick" ToolTip.Tip="Novo artigo">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <svg:Svg Classes="bo_line_icon_image"
                                                     Path="avares://LogicPOS.App/Assets/Images/Listing/botao_novo_b.svg" />
                                            <TextBlock Text="Novo" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SerialButton" Classes="bo_new_doc_tool" IsVisible="False" Click="OnSerialClick" ToolTip.Tip="Artigo único">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <svg:Svg Classes="bo_line_icon_image"
                                                     Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_artigos_artigos_b.svg" />
                                            <TextBlock Text="Série" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="bo_line_icon" Click="OnOpenArticlePad" ToolTip.Tip="Escolher">
                                        <svg:Svg Classes="bo_line_icon_image" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_ver_b.svg" />
                                    </Button>
                                    <Border Classes="bo_new_doc_total_box">
                                        <TextBlock x:Name="TotalLabel" Classes="bo_new_doc_total" Text="0,00 €" />
                                    </Border>
                                </StackPanel>
                                <Border Classes="bo_new_doc_search_field">
                                    <DockPanel>
                                        <Button x:Name="ArticleSearchClear"
                                                Classes="bo_listing_search_clear"
                                                DockPanel.Dock="Right"
                                                Click="OnArticleSearchClearClick"
                                                IsVisible="False"
                                                ToolTip.Tip="Limpar">
                                            <TextBlock Classes="bo_listing_search_clear_mark" Text="&#x00D7;" />
                                        </Button>
                                        <TextBox x:Name="ArticleSearch"
                                                 Classes="bo_new_doc_search_box"
                                                 PlaceholderText="Referência, descrição, família ou nº de série..."
                                                 TextChanged="OnSearchChanged"
                                                 KeyDown="OnSearchKeyDown" />
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                            <Border x:Name="ArticleSuggest" Classes="bo_new_doc_suggest" IsVisible="False">
                                <ScrollViewer>
                                    <StackPanel x:Name="ArticleSuggestList" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                        <Panel>
                            <DataGrid x:Name="LinesGrid"
                                      x:CompileBindings="False"
                                      Classes="bo_doc_grid bo_line_grid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserResizeColumns="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      DoubleTapped="OnLineOpen"
                                      LoadingRow="OnLineLoading">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ref." Binding="{Binding Code}" Width="80" MinWidth="70" />
                                    <DataGridTextColumn Header="Descrição" Binding="{Binding Designation}" Width="*" MinWidth="140" />
                                    <DataGridTextColumn Header="Nº série" Binding="{Binding SerialText}" Width="140" MinWidth="110" />
                                    <DataGridTextColumn Header="Qtd." Binding="{Binding QuantityText}" Width="80" MinWidth="70" />
                                    <DataGridTextColumn Header="Preço uni." Binding="{Binding PriceText}" Width="110" MinWidth="100" />
                                    <DataGridTextColumn Header="Preço s/ IVA" Binding="{Binding NetPriceText}" Width="120" MinWidth="110" />
                                    <DataGridTextColumn Header="Desc. %" Binding="{Binding DiscountText}" Width="90" MinWidth="80" />
                                    <DataGridTextColumn Header="Total s/ desconto" Binding="{Binding TotalWithoutDiscountText}" Width="140" MinWidth="130" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalText}" Width="110" MinWidth="90" />
                                    <DataGridTemplateColumn Header="" Width="88">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Classes="bo_line_icons">
                                                    <Button Classes="bo_line_icon" Click="OnEditRowClick" ToolTip.Tip="Editar">
                                                        <svg:Svg Classes="bo_line_icon_image" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_editar_b.svg" />
                                                    </Button>
                                                    <Button Classes="bo_line_icon" Click="OnRemoveRowClick" ToolTip.Tip="Eliminar">
                                                        <svg:Svg Classes="bo_line_icon_image" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_eliminar_b.svg" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="LinesEmpty" Classes="bo_new_doc_empty">
                                <svg:Svg Classes="bo_new_doc_empty_icon"
                                         Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_artigos_artigos.svg" />
                                <TextBlock Classes="bo_new_doc_empty_title" Text="Ainda não há artigos" />
                                <TextBlock Classes="bo_new_doc_empty_text"
                                           Text="Adicione artigos ao documento usando o campo abaixo" />
                            </StackPanel>
                        </Panel>
                    </DockPanel>
                </Border>
            </DockPanel>
        </DockPanel>
    </Border>
    <!-- Pegas de redimensionamento (bordas + cantos). -->
    <Border Classes="bo_resize_edge bo_resize_n" Tag="N" PointerPressed="OnDocumentResizePointerPressed" PointerMoved="OnDocumentResizePointerMoved" PointerReleased="OnDocumentResizePointerReleased" PointerCaptureLost="OnDocumentResizePointerCaptureLost" />
    <Border Classes="bo_resize_edge bo_resize_s" Tag="S" PointerPressed="OnDocumentResizePointerPressed" PointerMoved="OnDocumentResizePointerMoved" PointerReleased="OnDocumentResizePointerReleased" PointerCaptureLost="OnDocumentResizePointerCaptureLost" />
    <Border Classes="bo_resize_edge bo_resize_e" Tag="E" PointerPressed="OnDocumentResizePointerPressed" PointerMoved="OnDocumentResizePointerMoved" PointerReleased="OnDocumentResizePointerReleased" PointerCaptureLost="OnDocumentResizePointerCaptureLost" />
    <Border Classes="bo_resize_edge bo_resize_w" Tag="W" PointerPressed="OnDocumentResizePointerPressed" PointerMoved="OnDocumentResizePointerMoved" PointerReleased="OnDocumentResizePointerReleased" PointerCaptureLost="OnDocumentResizePointerCaptureLost" />
    <Border Classes="bo_resize_corner bo_resize_nw" Tag="NW" PointerPressed="OnDocumentResizePointerPressed" PointerMoved="OnDocumentResizePointerMoved" PointerReleased="OnDocumentResizePointerReleased" PointerCaptureLost="OnDocumentResizePointerCaptureLost" />
    <Border Classes="bo_resize_corner bo_resize_ne" Tag="NE" PointerPressed="OnDocumentResizePointerPressed" PointerMoved="OnDocumentResizePointerMoved" PointerReleased="OnDocumentResizePointerReleased" PointerCaptureLost="OnDocumentResizePointerCaptureLost" />
    <Border Classes="bo_resize_corner bo_resize_sw" Tag="SW" PointerPressed="OnDocumentResizePointerPressed" PointerMoved="OnDocumentResizePointerMoved" PointerReleased="OnDocumentResizePointerReleased" PointerCaptureLost="OnDocumentResizePointerCaptureLost" />
    <Border Classes="bo_resize_corner bo_resize_se" Tag="SE" PointerPressed="OnDocumentResizePointerPressed" PointerMoved="OnDocumentResizePointerMoved" PointerReleased="OnDocumentResizePointerReleased" PointerCaptureLost="OnDocumentResizePointerCaptureLost" />
    </Panel>
    <Border x:Name="LineEditor" Classes="bo_line_editor">
        <Border x:Name="LineEditorFrame" Classes="login_alert_frame bo_line_editor_frame">
            <DockPanel Classes="login_alert_inner">
                <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                    <DockPanel>
                        <Button Classes="bo_window_button" DockPanel.Dock="Right" Click="OnLineCancel" ToolTip.Tip="Fechar">
                            <svg:Svg Classes="bo_window_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/botao_fechar_w.svg" />
                        </Button>
                        <StackPanel Classes="login_alert_title_row">
                            <svg:Svg Classes="login_alert_title_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_editar_w.svg" />
                            <TextBlock Classes="login_alert_title" Text="Editar artigo" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                    <StackPanel x:Name="LineEditorActions" Classes="login_alert_action_buttons">
                        <Button Classes="login_alert_action" Click="OnLineOk">
                            <StackPanel Classes="login_alert_action_content">
                                <Image Classes="login_alert_action_icon"
                                       Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                                <TextBlock Classes="login_alert_action_text" Text="Ok" />
                            </StackPanel>
                        </Button>
                        <Button Classes="login_alert_action" Click="OnLineCancel">
                            <StackPanel Classes="login_alert_action_content">
                                <Image Classes="login_alert_action_icon"
                                       Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                                <TextBlock Classes="login_alert_action_text" Text="Cancelar" />
                            </StackPanel>
                        </Button>
                        <Button Classes="login_alert_action" Click="OnLineRemove">
                            <StackPanel Classes="login_alert_action_content">
                                <svg:Svg Classes="login_alert_action_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_eliminar_w.svg" />
                                <TextBlock Classes="login_alert_action_text" Text="Remover" />
                            </StackPanel>
                        </Button>
                        <Button Classes="login_alert_action" Click="OnLineClear">
                            <StackPanel Classes="login_alert_action_content">
                                <svg:Svg Classes="login_alert_action_icon" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_limpar_w.svg" />
                                <TextBlock Classes="login_alert_action_text" Text="Limpar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <ScrollViewer Classes="bo_new_doc_transport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="LineEditorFields" Classes="bo_line_editor_fields" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <StackPanel>
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_artigos_tipos_artigo_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Código" />
                        </StackPanel>
                        <TextBox x:Name="EditCode" Classes="bo_line_editor_input" IsReadOnly="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_artigos_artigos_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Artigo" />
                        </StackPanel>
                        <TextBox x:Name="EditDesignation" Classes="bo_line_editor_input" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_artigos_artigos.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Número de série" />
                        </StackPanel>
                        <TextBox x:Name="EditSerial" Classes="bo_line_editor_input" TextChanged="OnEditSerialChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_artigos_familas_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Família" />
                        </StackPanel>
                        <TextBox x:Name="EditFamily" Classes="bo_line_editor_input" IsReadOnly="True" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_artigos_tipos_preco_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Preço" />
                        </StackPanel>
                        <TextBox x:Name="EditPrice" Classes="bo_line_editor_input bo_numeric" TextChanged="OnEditValuesChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_artigos_gestao_stocks_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Quantidade" />
                        </StackPanel>
                        <TextBox x:Name="EditQuantity" Classes="bo_line_editor_input bo_numeric" TextChanged="OnEditValuesChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_clientes_grupo_desconto_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Desconto" />
                        </StackPanel>
                        <TextBox x:Name="EditDiscount" Classes="bo_line_editor_input bo_numeric" TextChanged="OnEditValuesChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_artigos_tipos_preco_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Total" />
                        </StackPanel>
                        <Border Classes="bo_new_doc_value_box">
                            <TextBlock x:Name="EditTotal" Classes="bo_new_doc_value" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_informacoes_fiscais_taxas_iva_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Total c/ IVA" />
                        </StackPanel>
                        <Border Classes="bo_new_doc_value_box">
                            <TextBlock x:Name="EditTotalVat" Classes="bo_new_doc_value" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_informacoes_fiscais_taxas_iva_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Taxa (%)" />
                        </StackPanel>
                        <ComboBox x:Name="EditVat" Classes="bo_new_doc_combo" SelectionChanged="OnEditVatChanged" />
                    </StackPanel>
                    <StackPanel x:Name="EditExemptionPanel" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_informacoes_fiscais_movimentos_isencao_iva_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Motivo de isenção de IVA" />
                        </StackPanel>
                        <ComboBox x:Name="EditExemption" Classes="bo_new_doc_combo" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.ColumnSpan="4">
                        <StackPanel Classes="bo_new_doc_label">
                            <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_editar_b.svg" />
                            <TextBlock Classes="bo_new_doc_caption" Text="Notas" />
                        </StackPanel>
                        <TextBox x:Name="EditNotes" Classes="bo_line_editor_notes" />
                    </StackPanel>
                    <TextBlock x:Name="EditError" Grid.Row="5" Grid.ColumnSpan="4" Classes="bo_new_doc_error" IsVisible="False" />
                </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Border>
    <Panel x:Name="CustomerEditor" Classes="login_alert_overlay" IsVisible="False">
        <Border x:Name="CustomerEditorFrame" Classes="login_alert_frame">
            <DockPanel Classes="login_alert_inner">
                <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                    <DockPanel>
                        <Button Classes="bo_window_button" DockPanel.Dock="Right" Click="OnCustomerEditorCancel" ToolTip.Tip="Fechar">
                            <svg:Svg Classes="bo_window_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/botao_fechar_w.svg" />
                        </Button>
                        <StackPanel Classes="login_alert_title_row">
                            <Image x:Name="CustomerEditorTitleIcon" Classes="login_alert_title_icon"
                                   Source="avares://LogicPOS.App/Assets/Images/Documents/icon_doc_new.png" />
                            <TextBlock x:Name="CustomerEditorTitle" Classes="login_alert_title" Text="Novo cliente" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                    <StackPanel Classes="login_alert_action_buttons">
                        <Button Classes="login_alert_action" Click="OnCustomerEditorOk">
                            <StackPanel Classes="login_alert_action_content">
                                <Image Classes="login_alert_action_icon"
                                       Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                                <TextBlock Classes="login_alert_action_text" Text="Ok" />
                            </StackPanel>
                        </Button>
                        <Button Classes="login_alert_action" Click="OnCustomerEditorCancel">
                            <StackPanel Classes="login_alert_action_content">
                                <Image Classes="login_alert_action_icon"
                                       Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                                <TextBlock Classes="login_alert_action_text" Text="Cancelar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <ScrollViewer Classes="bo_new_doc_transport">
                    <Grid Classes="bo_new_doc_fields bo_new_doc_editor" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <StackPanel Grid.ColumnSpan="3">
                            <StackPanel Classes="bo_new_doc_label">
                                <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_clientes_b.svg" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Cliente" />
                            </StackPanel>
                            <TextBox x:Name="EditorName" Classes="bo_line_editor_input" />
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <StackPanel Classes="bo_new_doc_label">
                                <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_informacoes_fiscais_b.svg" />
                                <TextBlock Classes="bo_new_doc_caption" Text="NIF" />
                            </StackPanel>
                            <DockPanel Classes="bo_touch_row">
                                <Button x:Name="EditorVies"
                                        Classes="bo_line_icon"
                                        DockPanel.Dock="Right"
                                        Click="OnCustomerViesClick"
                                        ToolTip.Tip="Consultar VIES">
                                    <svg:Svg Classes="bo_line_icon_image" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_pesquisar_b.svg" />
                                </Button>
                                <TextBox x:Name="EditorFiscal"
                                         Classes="bo_line_editor_input bo_numeric"
                                         LostFocus="OnCustomerFiscalLostFocus" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <StackPanel Classes="bo_new_doc_label">
                                <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_clientes_tipo_clientes_b.svg" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Número do Cartão de Cliente" />
                            </StackPanel>
                            <TextBox x:Name="EditorCard" Classes="bo_line_editor_input" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <StackPanel Classes="bo_new_doc_label">
                                <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_clientes_grupo_desconto_b.svg" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Desconto" />
                            </StackPanel>
                            <TextBox x:Name="EditorDiscount" Classes="bo_line_editor_input bo_numeric" Text="0,00" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                            <StackPanel Classes="bo_new_doc_label">
                                <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_origem_b.svg" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Morada" />
                            </StackPanel>
                            <TextBox x:Name="EditorAddress" Classes="bo_line_editor_input" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <StackPanel Classes="bo_new_doc_label">
                                <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_outras_tabelas_menu_dispositivos_paises_b.svg" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Localidade" />
                            </StackPanel>
                            <TextBox x:Name="EditorLocality" Classes="bo_line_editor_input" />
                        </StackPanel>
                        <StackPanel Grid.Row="3">
                            <StackPanel Classes="bo_new_doc_label">
                                <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_copiar_b.svg" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Código-postal" />
                            </StackPanel>
                            <TextBox x:Name="EditorZip" Classes="bo_line_editor_input bo_numeric" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1">
                            <StackPanel Classes="bo_new_doc_label">
                                <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_outras_tabelas_menu_dispositivos_paises_b.svg" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Cidade" />
                            </StackPanel>
                            <TextBox x:Name="EditorCity" Classes="bo_line_editor_input" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2">
                            <StackPanel Classes="bo_new_doc_label">
                                <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_outras_tabelas_menu_dispositivos_paises_b.svg" />
                                <TextBlock Classes="bo_new_doc_caption" Text="País" />
                            </StackPanel>
                            <ComboBox x:Name="EditorCountry" Classes="bo_new_doc_combo" />
                        </StackPanel>
                        <StackPanel Grid.Row="4">
                            <StackPanel Classes="bo_new_doc_label">
                                <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_clientes_b.svg" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Telefone" />
                            </StackPanel>
                            <TextBox x:Name="EditorPhone" Classes="bo_line_editor_input bo_numeric" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2">
                            <StackPanel Classes="bo_new_doc_label">
                                <Image Classes="bo_new_doc_label_icon" Source="avares://LogicPOS.App/Assets/Images/Documents/icon_doc_email_b.png" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Email" />
                            </StackPanel>
                            <TextBox x:Name="EditorEmail" Classes="bo_line_editor_input" />
                        </StackPanel>
                        <StackPanel Grid.Row="5">
                            <StackPanel Classes="bo_new_doc_label">
                                <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_clientes_tipo_clientes_b.svg" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Tipo de cliente" />
                            </StackPanel>
                            <ComboBox x:Name="EditorType" Classes="bo_new_doc_combo" />
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2">
                            <StackPanel Classes="bo_new_doc_label">
                                <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_artigos_tipos_preco_b.svg" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Tipo de preço" />
                            </StackPanel>
                            <ComboBox x:Name="EditorPrice" Classes="bo_new_doc_combo" />
                        </StackPanel>
                        <StackPanel Grid.Row="6" Grid.ColumnSpan="3">
                            <StackPanel Classes="bo_new_doc_label">
                                <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_editar_b.svg" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Notas" />
                            </StackPanel>
                            <TextBox x:Name="EditorNotes" Classes="bo_line_editor_notes" />
                        </StackPanel>
                        <TextBlock x:Name="EditorError" Grid.Row="7" Grid.ColumnSpan="3" Classes="bo_new_doc_error" />
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Panel>
    <Panel x:Name="ArticlePad" Classes="login_alert_overlay" IsVisible="False">
        <Border x:Name="ArticlePadFrame" Classes="login_alert_frame">
            <DockPanel>
                <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                    <StackPanel Classes="login_alert_title_row">
                        <Image Classes="login_alert_title_icon"
                               Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_window_documents.png" />
