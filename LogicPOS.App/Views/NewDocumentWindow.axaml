    <Panel x:Name="TransportOverlay" Classes="login_alert_overlay" IsVisible="False">
        <Border x:Name="TransportFrame" Classes="login_alert_frame">
            <DockPanel Classes="login_alert_inner">
                <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                    <StackPanel Classes="login_alert_title_row">
                        <Image Classes="login_alert_title_icon"
                               Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_window_documents.png" />
                        <TextBlock Classes="login_alert_title" Text="Dados de transporte" />
                    </StackPanel>
                </Border>
                <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                    <Button Classes="login_alert_action" Click="OnCloseTransportClick">
                        <StackPanel Classes="login_alert_action_content">
                            <Image Classes="login_alert_action_icon"
                                   Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                            <TextBlock Classes="login_alert_action_text" Text="Fechar" />
                        </StackPanel>
                    </Button>
                </Border>
                <ScrollViewer Classes="bo_new_doc_transport">
                    <StackPanel>
                    <Grid ColumnDefinitions="*,Auto,*" Classes="bo_new_doc_editor">
                        <Panel Grid.Column="1" Classes="bo_new_doc_ship_divider">
                            <Border Classes="bo_new_doc_ship_sep" />
                            <Border Classes="bo_new_doc_ship_arrow" ToolTip.Tip="Origem → Destino">
                                <TextBlock Classes="bo_new_doc_ship_arrow_mark" Text="→" />
                            </Border>
                        </Panel>
                        <StackPanel Grid.Column="2" Classes="bo_new_doc_ship">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Classes="bo_new_doc_ship_actions">
                                    <Button Classes="bo_ship_action" Click="OnUseCustomerAddress">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <svg:Svg Classes="bo_doc_action_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_clientes_b.svg" />
                                            <TextBlock Classes="bo_doc_action_text" Text="Cliente" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Classes="bo_new_doc_label">
                                    <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/menu_listagem_de_veiculos.svg" />
                                    <TextBlock Classes="bo_new_doc_ship_title" Text="Destino" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Classes="bo_new_doc_label">
                                <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_origem_b.svg" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Morada" />
                            </StackPanel>
                            <TextBox x:Name="ToAddress" Classes="bo_line_editor_input" />
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel>
                                    <StackPanel Classes="bo_new_doc_label">
                                        <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_outras_tabelas_menu_dispositivos_paises_b.svg" />
                                        <TextBlock Classes="bo_new_doc_caption" Text="Distrito" />
                                    </StackPanel>
                                    <TextBox x:Name="ToRegion" Classes="bo_line_editor_input" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Classes="bo_new_doc_label">
                                        <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_copiar_b.svg" />
                                        <TextBlock Classes="bo_new_doc_caption" Text="Código postal" />
                                    </StackPanel>
                                    <TextBox x:Name="ToPostal" Classes="bo_line_editor_input bo_numeric" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel>
                                    <StackPanel Classes="bo_new_doc_label">
                                        <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_outras_tabelas_menu_dispositivos_paises_b.svg" />
                                        <TextBlock Classes="bo_new_doc_caption" Text="Cidade" />
                                    </StackPanel>
                                    <TextBox x:Name="ToCity" Classes="bo_line_editor_input" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Classes="bo_new_doc_label">
                                        <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_outras_tabelas_menu_dispositivos_paises_b.svg" />
                                        <TextBlock Classes="bo_new_doc_caption" Text="País" />
                                    </StackPanel>
                                    <TextBox x:Name="ToCountry" Classes="bo_line_editor_input" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel>
                                    <StackPanel Classes="bo_new_doc_label">
                                        <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_calendario_b.svg" />
                                        <TextBlock Classes="bo_new_doc_caption" Text="Data de entrega" />
                                    </StackPanel>
                                    <DockPanel Classes="bo_touch_row">
                                        <Button Classes="bo_line_icon" DockPanel.Dock="Right" Click="OnOpenToDate" ToolTip.Tip="Calendário">
                                            <svg:Svg Classes="bo_line_icon_image" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_calendario_b.svg" />
                                        </Button>
                                        <CalendarDatePicker x:Name="ToDate" Classes="bo_new_doc_date" SelectedDateChanged="OnTransportDateChanged" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Classes="bo_new_doc_label">
                                        <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_calendario_b.svg" />
                                        <TextBlock Classes="bo_new_doc_caption" Text="Hora" />
                                    </StackPanel>
                                    <TimePicker x:Name="ToTime" Classes="bo_new_doc_time" ClockIdentifier="24HourClock" SelectedTimeChanged="OnTransportTimeChanged" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="0" Classes="bo_new_doc_ship">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Classes="bo_new_doc_ship_actions">
                                    <Button Classes="bo_ship_action" Click="OnCopyDestinationToOrigin">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <svg:Svg Classes="bo_doc_action_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_copiar_b.svg" />
                                            <TextBlock Classes="bo_doc_action_text" Text="Igual ao destino" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="bo_ship_action" Click="OnUseCompanyAddress">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <svg:Svg Classes="bo_doc_action_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_configuracoes_preferencias_empresa_b.svg" />
                                            <TextBlock Classes="bo_doc_action_text" Text="Empresa" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Classes="bo_new_doc_label">
                                    <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_origem_b.svg" />
                                    <TextBlock Classes="bo_new_doc_ship_title" Text="Origem" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Classes="bo_new_doc_label">
                                <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_origem_b.svg" />
                                <TextBlock Classes="bo_new_doc_caption" Text="Morada" />
                            </StackPanel>
                            <TextBox x:Name="FromAddress" Classes="bo_line_editor_input" />
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel>
                                    <StackPanel Classes="bo_new_doc_label">
                                        <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_outras_tabelas_menu_dispositivos_paises_b.svg" />
                                        <TextBlock Classes="bo_new_doc_caption" Text="Distrito" />
                                    </StackPanel>
                                    <TextBox x:Name="FromRegion" Classes="bo_line_editor_input" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Classes="bo_new_doc_label">
                                        <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_copiar_b.svg" />
                                        <TextBlock Classes="bo_new_doc_caption" Text="Código postal" />
                                    </StackPanel>
                                    <TextBox x:Name="FromPostal" Classes="bo_line_editor_input bo_numeric" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel>
                                    <StackPanel Classes="bo_new_doc_label">
                                        <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_outras_tabelas_menu_dispositivos_paises_b.svg" />
                                        <TextBlock Classes="bo_new_doc_caption" Text="Cidade" />
                                    </StackPanel>
                                    <TextBox x:Name="FromCity" Classes="bo_line_editor_input" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Classes="bo_new_doc_label">
                                        <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_outras_tabelas_menu_dispositivos_paises_b.svg" />
                                        <TextBlock Classes="bo_new_doc_caption" Text="País" />
                                    </StackPanel>
                                    <TextBox x:Name="FromCountry" Classes="bo_line_editor_input" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel>
                                    <StackPanel Classes="bo_new_doc_label">
                                        <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_calendario_b.svg" />
                                        <TextBlock Classes="bo_new_doc_caption" Text="Data de expedição" />
                                    </StackPanel>
                                    <DockPanel Classes="bo_touch_row">
                                        <Button Classes="bo_line_icon" DockPanel.Dock="Right" Click="OnOpenFromDate" ToolTip.Tip="Calendário">
                                            <svg:Svg Classes="bo_line_icon_image" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_calendario_b.svg" />
                                        </Button>
                                        <CalendarDatePicker x:Name="FromDate" Classes="bo_new_doc_date" SelectedDateChanged="OnTransportDateChanged" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Classes="bo_new_doc_label">
                                        <svg:Svg Classes="bo_new_doc_label_icon" Path="avares://LogicPOS.App/Assets/Images/Documents/botao_calendario_b.svg" />
                                        <TextBlock Classes="bo_new_doc_caption" Text="Hora" />
                                    </StackPanel>
                                    <TimePicker x:Name="FromTime" Classes="bo_new_doc_time" ClockIdentifier="24HourClock" SelectedTimeChanged="OnTransportTimeChanged" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TransportDateError" Classes="bo_new_doc_error" IsVisible="False" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Panel>
    <Panel x:Name="NewArticleOverlay" Classes="login_alert_overlay" IsVisible="False">
        <Border x:Name="NewArticleFrame" Classes="login_alert_frame">
            <DockPanel Classes="login_alert_inner">
                <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                    <DockPanel>
                        <Button Classes="bo_window_button" DockPanel.Dock="Right" Click="OnNewArticleCloseClick" ToolTip.Tip="Fechar">
                            <svg:Svg Classes="bo_window_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/botao_fechar_w.svg" />
                        </Button>
                        <StackPanel Classes="login_alert_title_row">
                            <svg:Svg Classes="login_alert_title_icon" Path="avares://LogicPOS.App/Assets/Images/Listing/botao_novo_w.svg" />
                            <TextBlock Classes="login_alert_title" Text="Novo artigo" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                    <StackPanel Classes="login_alert_action_buttons">
                        <Button Classes="login_alert_action" Click="OnNewArticleSaveClick">
                            <StackPanel Classes="login_alert_action_content">
                                <Image Classes="login_alert_action_icon" Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_ok.png" />
                                <TextBlock Classes="login_alert_action_text" Text="Criar" />
                            </StackPanel>
                        </Button>
                        <Button Classes="login_alert_action" Click="OnNewArticleCloseClick">
                            <StackPanel Classes="login_alert_action_content">
                                <Image Classes="login_alert_action_icon" Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                                <TextBlock Classes="login_alert_action_text" Text="Cancelar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <ScrollViewer>
                    <StackPanel Classes="bo_quick_dialog_body">
                        <TextBlock Classes="bo_new_doc_caption" Text="Código" />
                        <TextBox x:Name="NewArticleCode" Classes="bo_entity_input" PlaceholderText="Gerado se ficar vazio" />
                        <TextBlock Classes="bo_new_doc_caption" Text="Designação" />
                        <TextBox x:Name="NewArticleName" Classes="bo_entity_input" />
                        <TextBlock Classes="bo_new_doc_caption" Text="Preço" />
                        <TextBox x:Name="NewArticlePrice" Classes="bo_entity_input bo_numeric" Text="0" />
                        <TextBlock Classes="bo_new_doc_caption" Text="Subfamília" />
                        <AutoCompleteBox x:Name="NewArticleFamily" Classes="bo_entity_input" />
                        <TextBlock Classes="bo_new_doc_caption" Text="IVA" />
                        <ComboBox x:Name="NewArticleVat" Classes="bo_entity_input" />
                        <CheckBox x:Name="NewArticleUnique" Classes="bo_entity_input" Content="Artigos únicos (número de série)" />
                        <TextBlock x:Name="NewArticleError" Classes="bo_new_doc_error" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Panel>
    <Panel x:Name="SerialOverlay" Classes="login_alert_overlay" IsVisible="False">
        <Border x:Name="SerialFrame" Classes="login_alert_frame">
            <DockPanel Classes="login_alert_inner">
                <Border Classes="login_alert_titlebar" DockPanel.Dock="Top">
                    <DockPanel>
                        <Button Classes="bo_window_button" DockPanel.Dock="Right" Click="OnSerialCloseClick" ToolTip.Tip="Fechar">
                            <svg:Svg Classes="bo_window_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/botao_fechar_w.svg" />
                        </Button>
                        <StackPanel Classes="login_alert_title_row">
                            <svg:Svg Classes="login_alert_title_icon" Path="avares://LogicPOS.App/Assets/Images/BackOffice/Menu/menu_artigos_artigos.svg" />
                            <TextBlock Classes="login_alert_title" Text="Artigo único" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Classes="login_alert_actions" DockPanel.Dock="Bottom">
                    <StackPanel Classes="login_alert_action_buttons">
                        <Button Classes="login_alert_action" Click="OnSerialCloseClick">
                            <StackPanel Classes="login_alert_action_content">
                                <Image Classes="login_alert_action_icon" Source="avares://LogicPOS.App/Assets/Images/Dialogs/icon_pos_dialog_action_no.png" />
                                <TextBlock Classes="login_alert_action_text" Text="Fechar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <DockPanel Classes="bo_quick_dialog_body">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Classes="bo_new_doc_caption" Text="Número de série" />
                        <TextBox x:Name="SerialSearch"
                                 Classes="bo_entity_input"
                                 PlaceholderText="Número de série, código ou artigo"
                                 TextChanged="OnSerialSearchChanged" />
                        <TextBlock x:Name="SerialNotice" Classes="bo_new_doc_error" />
                    </StackPanel>
                    <ScrollViewer>
                        <StackPanel x:Name="SerialList" Classes="bo_serial_list" />
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>
        </Border>
    </Panel>
    <views:ListingBusy x:Name="Busy" ZIndex="100" />
    </Grid>
</UserControl>
