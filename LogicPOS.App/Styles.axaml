    <Style Selector="TextBox.bo_new_doc_search_box">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#15202B" />
        <Setter Property="PlaceholderForeground" Value="#9AA3AD" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#C5CED6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.bo_report_group">
        <Setter Property="Background" Value="#9bbe1d" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="TextBlock.bo_report_group_text">
        <Setter Property="Foreground" Value="#323537" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.bo_report_row">
        <Setter Property="Background" Value="#F4F6F8" />
        <Setter Property="Foreground" Value="#323537" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.bo_report_row:pointerover">
        <Setter Property="Background" Value="#E4E8EC" />
    </Style>

    <Style Selector="Button.bo_report_row.bo_report_row_on">
        <Setter Property="Background" Value="#9bbe1d" />
        <Setter Property="Foreground" Value="#323537" />
    </Style>

    <Style Selector="UserControl.bo_listing_busy_host">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Panel.bo_listing_busy">
        <Setter Property="Background" Value="#E6FFFFFF" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="StackPanel.bo_listing_busy_box">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Spacing" Value="10" />
    </Style>

    <Style Selector="Panel.bo_listing_spinner_host">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="Ellipse.bo_listing_spinner_track">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Stroke" Value="#E4E8EC" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Path.bo_listing_spinner">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="#9bbe1d" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Style.Animations>
            <Animation Duration="0:0:0.8" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="TextBlock.bo_listing_busy_label">
        <Setter Property="Foreground" Value="#323537" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

