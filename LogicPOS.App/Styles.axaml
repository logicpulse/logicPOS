<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia">
    <Style Selector="Window.login_window">
        <Setter Property="Background" Value="#111111" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="avares://LogicPOS.App/Assets/Fonts#Montserrat" />
    </Style>

    <Style Selector="Image.app_background">
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Width" Value="1920" />
        <Setter Property="Height" Value="1080" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="Button.login_minimize">
        <Setter Property="Width" Value="27" />
        <Setter Property="Height" Value="27" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,10,10,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Image Source="avares://LogicPOS.App/Assets/Images/icon_window_minimize.png"
                       Width="27"
                       Height="27"
                       Stretch="None" />
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Image.login_logo">
        <Setter Property="Width" Value="460" />
        <Setter Property="Height" Value="157" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,16,48,0" />
    </Style>

    <Style Selector="Border.login_users_frame">
        <Setter Property="Width" Value="148" />
        <Setter Property="Height" Value="861" />
        <Setter Property="Margin" Value="108,105,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="#38FFFFFF" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="Border.login_pinpad_frame">
        <Setter Property="Width" Value="344" />
        <Setter Property="Height" Value="466" />
        <Setter Property="Margin" Value="0,0,104,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="#38FFFFFF" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="StackPanel.login_users_column">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="120,120,0,0" />
        <Setter Property="Spacing" Value="0" />
        <Setter Property="Width" Value="120" />
    </Style>

    <Style Selector="Button.login_scroll">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="60" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Background" Value="#3D3D3D" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Image.login_scroll_icon">
        <Setter Property="Stretch" Value="Fill" />
    </Style>

    <Style Selector="ItemsControl.login_users">
        <Setter Property="Width" Value="120" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Panel.login_user_slot">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="102" />
    </Style>

    <Style Selector="Button.login_user">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="102" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="Background" Value="#AAAAAA" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.login_user:pointerover">
        <Setter Property="Background" Value="#C4C4C4" />
    </Style>

    <Style Selector="Button.login_user.selected">
        <Setter Property="Background" Value="#2B2B2B" />
    </Style>

    <Style Selector="Button.login_user.selected:pointerover">
        <Setter Property="Background" Value="#3A3A3A" />
    </Style>

    <Style Selector="Image.login_user_icon">
        <Setter Property="Stretch" Value="UniformToFill" />
    </Style>

    <Style Selector="Border.login_user_caption">
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Background" Value="#FAFFFFFF" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="TextBlock.login_user_name">
        <Setter Property="FontFamily" Value="avares://LogicPOS.App/Assets/Fonts#Montserrat" />
        <Setter Property="FontSize" Value="7" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="Border.login_pinpad">
        <Setter Property="Width" Value="315" />
        <Setter Property="Height" Value="466" />
        <Setter Property="Padding" Value="0,49,0,12" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,120,0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Grid.login_pinpad_keys">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Button.login_pin_key">
        <Setter Property="Background" Value="#AAAAAA" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Height" Value="52" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        TextBlock.FontSize="{TemplateBinding FontSize}"
                        TextBlock.FontWeight="{TemplateBinding FontWeight}"
                        TextBlock.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.login_pin_key:pointerover">
        <Setter Property="Background" Value="#C4C4C4" />
    </Style>

    <Style Selector="Button.login_pin_key:pressed">
        <Setter Property="Background" Value="#999999" />
    </Style>

    <Style Selector="Button.login_pin_key:disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="Button.login_pin_digit">
        <Setter Property="Width" Value="99" />
    </Style>

    <Style Selector="Button.login_pin_ce">
        <Setter Property="Background" Value="#C25E4F" />
        <Setter Property="Width" Value="99" />
    </Style>

    <Style Selector="Button.login_pin_ce:pointerover">
        <Setter Property="Background" Value="#D17A6C" />
    </Style>

    <Style Selector="Button.login_pin_ce:pressed">
        <Setter Property="Background" Value="#A84E42" />
    </Style>

    <Style Selector="Button.login_pin_quit">
        <Setter Property="Background" Value="#485460" />
        <Setter Property="Width" Value="99" />
    </Style>

    <Style Selector="Button.login_pin_quit:pointerover">
        <Setter Property="Background" Value="#5C6B78" />
    </Style>

    <Style Selector="Button.login_pin_quit:pressed">
        <Setter Property="Background" Value="#323A42" />
    </Style>

    <Style Selector="Button.login_pin_ok">
        <Setter Property="Background" Value="#8BA844" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Width" Value="309" />
    </Style>

    <Style Selector="Button.login_pin_ok:pointerover">
        <Setter Property="Background" Value="#A4C45A" />
    </Style>

    <Style Selector="Button.login_pin_ok:pressed">
        <Setter Property="Background" Value="#738C38" />
    </Style>

    <Style Selector="TextBox.login_pin_entry">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,0,36,0" />
        <Setter Property="CaretBrush" Value="#000000" />
    </Style>

    <Style Selector="TextBox.login_pin_entry.error">
        <Setter Property="Foreground" Value="#FF0000" />
        <Setter Property="CaretBrush" Value="#FF0000" />
    </Style>

    <Style Selector="StackPanel.login_pin_tools">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Spacing" Value="2" />
        <Setter Property="ZIndex" Value="2" />
    </Style>

    <Style Selector="Button.login_pin_reveal">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ZIndex" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.login_pin_reveal:pointerover">
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style Selector="svg|Svg.login_pin_eye">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Ellipse.login_pin_eye_outline">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Stroke" Value="#343537" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Ellipse.login_pin_eye_pupil">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Fill" Value="#343537" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Path.login_pin_eye_slash">
        <Setter Property="Stroke" Value="#343537" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.login_pin_reset">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Background" Value="#AAAAAA" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Image Source="avares://LogicPOS.App/Assets/Images/pinpad_password_reset.png"
                           Width="22"
                           Height="22"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.login_pin_reset:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="TextBlock.login_pin_status">
        <Setter Property="Foreground" Value="#C8C8C8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="3" />
    </Style>

    <Style Selector="TextBlock.login_version">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="2,2,2,4" />
        <Setter Property="Foreground" Value="#B8B8B8" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Opacity" Value="0.95" />
    </Style>

    <Style Selector="Panel.login_alert_overlay">
        <Setter Property="Background" Value="#99000000" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Panel.login_alert_overlay.bo_clear_overlay">
        <Setter Property="Background" Value="#33000000" />
    </Style>

    <Style Selector="Border.login_alert_frame">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D6D6D6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BoxShadow" Value="0 12 28 0 #66000000" />
    </Style>

    <Style Selector="DockPanel.login_alert_inner">
        <Setter Property="Background" Value="#FFFFFF" />
    </Style>

    <Style Selector="Border.login_alert_titlebar">
        <Setter Property="Height" Value="42" />
        <Setter Property="Background" Value="#3D3D3D" />
        <Setter Property="CornerRadius" Value="8,8,0,0" />
        <Setter Property="Padding" Value="8,0,8,0" />
    </Style>

    <Style Selector="StackPanel.login_alert_title_row">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Spacing" Value="2" />
        <Setter Property="Margin" Value="2,0,2,0" />
    </Style>

    <Style Selector="Image.login_alert_title_icon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <Style Selector="TextBlock.login_alert_title">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Grid.login_alert_body">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Image.login_alert_symbol">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="96" />
        <Setter Property="Margin" Value="18,16,0,0" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="Border.bo_update_frame">
        <Setter Property="Width" Value="480" />
        <Setter Property="Height" Value="340" />
    </Style>

    <Style Selector="TextBlock.bo_update_status">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#4D6610" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="132,150,18,8" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="TextBlock.login_alert_message">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="132,44,18,8" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="Border.login_alert_actions">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Padding" Value="0,4,12,8" />
        <Setter Property="CornerRadius" Value="0,0,8,8" />
    </Style>

    <Style Selector="StackPanel.login_alert_action_buttons">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Spacing" Value="8" />
    </Style>

    <Style Selector="Button.login_alert_action">
        <Setter Property="Width" Value="84" />
        <Setter Property="Height" Value="52" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#4477A4" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        TextBlock.Foreground="{TemplateBinding Foreground}"
                        TextBlock.FontSize="{TemplateBinding FontSize}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.login_alert_action:pointerover">
        <Setter Property="Background" Value="#5A8BB8" />
    </Style>

    <Style Selector="Button.login_alert_action:disabled">
        <Setter Property="Background" Value="#999999" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="StackPanel.login_alert_action_content">
        <Setter Property="Spacing" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="Image.login_alert_action_icon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="svg|Svg.login_alert_action_icon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.login_alert_action_text">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="Window.pos_window">
        <Setter Property="Background" Value="#111111" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="avares://LogicPOS.App/Assets/Fonts#Montserrat" />
    </Style>

    <Style Selector="Border.pos_logo_box">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Image.pos_logo">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.pos_status_bar_1">
        <Setter Property="Background" Value="#585858" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Border.pos_status_bar_2">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Grid.pos_status_bar_content">
        <Setter Property="Margin" Value="8,0" />
    </Style>

    <Style Selector="TextBlock.pos_status_text">
        <Setter Property="Foreground" Value="#EEEEEE" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.pos_status_text_small">
        <Setter Property="Foreground" Value="#DADADA" />
        <Setter Property="FontSize" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.pos_ticket_list">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#6A6A6A" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.pos_ticket_header_row">
        <Setter Property="Background" Value="#E4E4E4" />
        <Setter Property="BorderBrush" Value="#C8C8C8" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="TextBlock.pos_ticket_header">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="TextBlock.pos_ticket_header_right">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style Selector="Border.pos_ticket_total">
        <Setter Property="Background" Value="#3D3D3D" />
        <Setter Property="BorderBrush" Value="#2E2E2E" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Height" Value="48" />
